# Local dev: matches docker-compose.yml. In production, point this at your managed Postgres.
DATABASE_URL="postgresql://futuretutor:futuretutor_dev@localhost:5433/futuretutor"

# INFRA-1A — Supabase staging database. FutureTutor runs as a persistent
# server process (Railway), not serverless functions, so this app uses
# Supabase's Session Pooler connection (port 5432) as the SAME single
# DATABASE_URL for both the running app AND `prisma migrate deploy` — no
# separate DIRECT_URL is needed for this deployment shape (Prisma 7 also
# removed the classic schema-level `directUrl` datasource property entirely,
# so a two-URL split can no longer be expressed in prisma.config.ts anyway;
# it would require an env-var override at deploy time instead). Do NOT use
# the Transaction Pooler (port 6543, `?pgbouncer=true`) here -- that mode is
# for serverless/edge deployments and is unnecessary complexity for a
# long-running server, given Session Pooler already preserves full Postgres
# connection semantics (prepared statements, multi-statement Serializable
# transactions -- see src/lib/serializableRetry.ts) that Transaction Mode
# does not guarantee.
#
# Expected shape (get the real value from Supabase Dashboard -> Project
# Settings -> Database -> Connection string -> Session pooler):
#   postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
#
# Set this as a SEPARATE .env (e.g. .env.staging, never committed) or as an
# actual environment variable on whatever process applies migrations/runs
# the app against staging -- never by editing this checked-in .env.example
# file, and never by overwriting your local DATABASE_URL above while doing
# local development.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-real-generated-secret"

# Only needed in production (Auth.js infers it in dev)
# AUTH_URL="https://www.futuretutor.ca"

# Dev-only seeded SUPER_ADMIN account (never used in production seeding)
SEED_ADMIN_EMAIL="admin@futuretutor.local"
SEED_ADMIN_PASSWORD="replace-with-a-dev-password"

# L1-01B — production password-reset email delivery (see src/lib/email/).
#
# Both RESEND_API_KEY and EMAIL_FROM are REQUIRED when NODE_ENV=production —
# getEmailDeliveryMode() (src/lib/email/emailDeliveryConfig.ts) throws
# EmailConfigurationError and refuses to send if either is missing in
# production; it never silently falls back to console/dev delivery there.
#
# In any other environment (dev/test/staging without NODE_ENV=production),
# both are OPTIONAL — leave them unset to use the console/dev EmailService
# (consoleDevSendPasswordResetEmail), which requires no real provider
# account. Set both to opt into exercising real Resend delivery locally.
#
# RESEND_API_KEY="re_..."
#
# Must be a verified Resend sending identity, e.g.:
#   FutureTutor <no-reply@futuretutor.ca>
# See the L1-01B report's EXTERNAL SETUP REPORT section for what domain
# verification this requires in the Resend dashboard.
# EMAIL_FROM="FutureTutor <no-reply@futuretutor.ca>"

# Quick Match dispatch-timeout liveness sweep (/api/cron/quick-match-tick).
# Not load-bearing for correctness — lazy expiry-on-read is the primary
# mechanism (see src/services/quickMatchDispatch.ts); this just advances
# abandoned requests nobody is actively viewing. Generate any random string.
QUICK_MATCH_CRON_SECRET="replace-with-a-real-generated-secret"

# Phase G — Payments. See src/lib/paymentMode.ts and src/lib/stripe.ts.
#
# PAYMENT_MODE must be exactly one of three explicit values — an unset or
# unrecognized value fails closed (throws) rather than defaulting to any
# mode:
#
#   disabled_dev  Local dev/regression-test bypass. No Stripe calls at all;
#                 no Stripe keys required. Never honored when
#                 NODE_ENV=production (ignored with a warning; production
#                 always requires real, validated live credentials instead).
#
#   stripe_test   Real Stripe SDK calls against Stripe's sandbox/test mode.
#                 Requires STRIPE_SECRET_KEY to start with "sk_test_" and
#                 STRIPE_PUBLISHABLE_KEY to start with "pk_test_" — a
#                 missing key, a live key, or a mixed test/live pair all
#                 fail configuration validation. This is the mode Phase G.1
#                 sandbox verification runs under.
#
#   live          Production Stripe processing. Requires STRIPE_SECRET_KEY
#                 to start with "sk_live_" and STRIPE_PUBLISHABLE_KEY to
#                 start with "pk_live_" — test-mode keys are rejected.
#
PAYMENT_MODE="disabled_dev"

# Required for stripe_test and live (see the prefix rules above). Leave
# unset for disabled_dev. Never commit real secret/live keys.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Reconciliation/transfer sweep (/api/cron/payments-tick) — same shared-
# secret pattern as QUICK_MATCH_CRON_SECRET above.
PAYMENTS_CRON_SECRET="replace-with-a-real-generated-secret"

# Session Lifecycle Phase 3 (no-show) + Phase 4 (completion) convergence
# liveness sweep (/api/cron/session-noshow-tick). No-show convergence is not
# load-bearing for correctness — the convergence-first step embedded in
# recordSessionCheckIn is the primary mechanism. Completion convergence has
# NO embedded/lazy trigger by design (see sweepDueSessionCompletionConvergence
# in src/services/sessionLifecycle.ts) — in this environment this sweep is,
# in practice, the PRIMARY way a Session ever reaches COMPLETED, not merely a
# backstop. Same shared-secret pattern as QUICK_MATCH_CRON_SECRET/
# PAYMENTS_CRON_SECRET above; the env var name is kept as-is for continuity
# even though this route now covers more than just no-show (mirrors
# PAYMENTS_CRON_SECRET already covering multiple sweep concerns).
SESSION_NOSHOW_CRON_SECRET="replace-with-a-real-generated-secret"

# VIDEO-1A — Daily.co server-side room/token API (src/lib/dailyClient.ts,
# src/services/dailyVideoProvider.ts). Server-only: never exposed to the
# browser (no NEXT_PUBLIC_ prefix), never logged. Optional — when unset, the
# video room-provisioning sweep in /api/cron/session-noshow-tick skips
# gracefully rather than failing. Get a real value from the Daily dashboard
# (a TEST-mode/sandbox project's API key for local/staging use — never a
# production Daily project's key in a non-production environment).
# DAILY_API_KEY=""

# QA-1 — Playwright E2E. Never commit actual credentials or generated auth state.
# E2E_TARGET="local" # local | staging
# E2E_BASE_URL="http://localhost:3000"
# E2E_STUDENT_EMAIL="student@futuretutor.local"
# E2E_STUDENT_PASSWORD="replace-with-a-test-password"
# E2E_TUTOR_EMAIL="tutor@futuretutor.local"
# E2E_TUTOR_PASSWORD="replace-with-a-test-password"
# E2E_ADMIN_EMAIL="admin-staging@futuretutor.local"
# E2E_ADMIN_PASSWORD="replace-with-a-test-password"
# External email and financial E2Es are excluded from the normal suite.
# E2E_EXTERNAL_EMAIL="false"
# E2E_FINANCIAL="false"
