# Local dev: matches docker-compose.yml. In production, point this at your managed Postgres.
DATABASE_URL="postgresql://futuretutor:futuretutor_dev@localhost:5433/futuretutor"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-real-generated-secret"

# Only needed in production (Auth.js infers it in dev)
# AUTH_URL="https://www.futuretutor.ca"

# Dev-only seeded SUPER_ADMIN account (never used in production seeding)
SEED_ADMIN_EMAIL="admin@futuretutor.local"
SEED_ADMIN_PASSWORD="replace-with-a-dev-password"

# Optional — email provider. Leave unset to use the console/dev EmailService.
# RESEND_API_KEY=""

# Quick Match dispatch-timeout liveness sweep (/api/cron/quick-match-tick).
# Not load-bearing for correctness — lazy expiry-on-read is the primary
# mechanism (see src/services/quickMatchDispatch.ts); this just advances
# abandoned requests nobody is actively viewing. Generate any random string.
QUICK_MATCH_CRON_SECRET="replace-with-a-real-generated-secret"
