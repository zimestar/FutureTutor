// FutureTutor marketplace schema.
// Grouped by domain; see /prisma/README.md is skipped in favor of inline
// comments — each model notes the phase that actually uses it so an empty
// table isn't mistaken for a bug.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Phase A). Standard Account/Session/VerificationToken shape matches
// what @auth/prisma-adapter expects, so adding Google/Apple OAuth later is
// additive, not a rework — even though Phase A's Credentials-only auth uses
// JWT sessions and doesn't touch these adapter tables yet.
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  PARENT
  TUTOR
  ADMIN
  SUPER_ADMIN
}

enum AdminRolePreset {
  FULL_ACCESS
  OPERATIONS
  TUTOR_SUCCESS
  FINANCE_READ_ONLY
  CUSTOM
}

enum AdminPermission {
  ADMIN_DASHBOARD_VIEW
  ADMIN_USERS_READ
  ADMIN_USERS_WRITE
  ADMIN_TUTORS_READ
  ADMIN_TUTORS_REVIEW
  ADMIN_TUTORS_APPROVE
  ADMIN_TUTORS_SUSPEND
  ADMIN_STUDENTS_READ
  ADMIN_STUDENTS_SUSPEND
  ADMIN_GUARDIANS_READ
  ADMIN_GUARDIANS_SUSPEND
  ADMIN_BOOKINGS_READ
  ADMIN_SESSIONS_READ
  ADMIN_QUICKMATCH_READ
  ADMIN_QUICKMATCH_MANAGE
  ADMIN_PAYMENTS_READ
  ADMIN_PRICING_READ
  ADMIN_PRICING_MANAGE
  ADMIN_ADMINS_VIEW
  ADMIN_ADMINS_MANAGE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deactivatedAt DateTime?

  // FG-LEGAL1A — minimal, auditable Terms-of-Service acceptance record,
  // captured at signup. Null on any account created before this field
  // existed (never backfilled — recording a version/timestamp for an
  // acceptance that was never actually shown would be dishonest, not a
  // real omission to "fix"). termsAcceptedVersion is a plain date-stamp
  // string (e.g. "2026-08-30") matching the Terms document's own Effective
  // Date, not a semantic version — mirrors this codebase's existing
  // pricingVersion/scoreVersion string-stamp convention.
  termsAcceptedAt      DateTime?
  termsAcceptedVersion String?
  termsAcceptedLocale  String?

  accounts                        Account[]
  sessions                        Session[]
  studentProfile                  StudentProfile?
  parentProfile                   ParentProfile?
  tutorProfile                    TutorProfile?
  sentMessages                    Message[]                   @relation("MessageSender")
  conversations                   ConversationParticipant[]
  notifications                   Notification[]
  notificationPreference          NotificationPreference?
  auditLogs                       AuditLog[]                  @relation("AuditActor")
  bookingStatusChanges            BookingStatusHistory[]      @relation("BookingStatusChangedBy")
  createdPriceQuotes              CustomerPriceQuote[]
  createdTutoringRequests         TutoringRequest[]
  payments                        Payment[]
  guardianRelationshipsCreated    ParentStudentRelationship[] @relation("GuardianRelationshipCreatedBy")
  guardianRelationshipsRevoked    ParentStudentRelationship[] @relation("GuardianRelationshipRevokedBy")
  familyInvitationsInvited        FamilyInvitation[]          @relation("FamilyInvitationInvitedBy")
  familyInvitationsClaimed        FamilyInvitation[]          @relation("FamilyInvitationClaimedBy")
  familyInvitationsApproved       FamilyInvitation[]          @relation("FamilyInvitationApprovedBy")
  consentRecords                  ConsentRecord[]             @relation("ConsentActor")
  sessionAttendanceEventsRecorded SessionAttendanceEvent[]    @relation("SessionAttendanceRecordedBy")
  adminInvitationsSent            AdminInvitation[]           @relation("AdminInvitationInvitedBy")
  adminInvitationAccepted         AdminInvitation?            @relation("AdminInvitationAcceptedUser")
  adminPermissions                AdminPermissionAssignment[] @relation("AdminPermissionUser")
  adminPermissionsGranted         AdminPermissionAssignment[] @relation("AdminPermissionGrantedBy")

  @@index([role])
}

model AdminInvitation {
  id             String            @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  invitedById    String
  tokenHash      String            @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  rolePreset     AdminRolePreset
  permissions    AdminPermission[]
  acceptedUserId String?           @unique
  createdAt      DateTime          @default(now())

  invitedBy    User  @relation("AdminInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedUser User? @relation("AdminInvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
}

model AdminPermissionAssignment {
  id          String          @id @default(cuid())
  userId      String
  permission  AdminPermission
  grantedById String
  createdAt   DateTime        @default(now())

  user      User @relation("AdminPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("AdminPermissionGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, permission])
  @@index([permission])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Student / Parent (Phase A creates the tables + registration rows;
// StudentProfile fields and LearningGoal get filled in via onboarding UI
// in Phase B).
// ---------------------------------------------------------------------------

enum TutoringMode {
  ONLINE
  IN_PERSON
  BOTH
}

/// Phase H.1 — who is authoritative for this StudentProfile's account
/// management, consent, and financial decisions. Independent of age
/// (StudentProfile.dateOfBirth) and independent of whether the profile has
/// its own login (StudentProfile.userId != null) — see the Phase H planning
/// report's "Account Management Authority Model" section. SELF_MANAGED and
/// GUARDIAN_MANAGED are the two real states; LEGACY_UNKNOWN is reserved for
/// a hypothetical future data-provenance gap and is never produced by this
/// migration's own backfill (every existing row becomes SELF_MANAGED, since
/// every existing row was created via the adult self-signup path).
enum StudentManagementMode {
  SELF_MANAGED
  GUARDIAN_MANAGED
  LEGACY_UNKNOWN
}

model StudentProfile {
  id                String                @id @default(cuid())
  /// Phase H.1 — nullable (was required through Phase G.1): a
  /// GUARDIAN_MANAGED child created by a parent may have no login of their
  /// own yet. See the DB-level CHECK constraint (added via hand-edited
  /// migration SQL) enforcing that SELF_MANAGED always requires this to be
  /// non-null — a self-managed profile can never exist with no User to
  /// manage it.
  userId            String?               @unique
  firstName         String
  lastName          String
  preferredLanguage String                @default("en")
  province          String?
  city              String?
  academicLevelId   String?
  tutoringMode      TutoringMode          @default(BOTH)
  /// Phase H.1 — nullable at the DB level for legacy-compatibility (existing
  /// rows have none) and because collecting it is an application-layer
  /// onboarding decision, not a hard DB requirement. Age derivation
  /// (isMinor()) and any onboarding-required-field enforcement are later
  /// Phase H sub-phase concerns, not implemented here.
  dateOfBirth       DateTime?
  /// Phase H.1 — see StudentManagementMode's own doc comment. NOT NULL with
  /// no schema-level default; every existing row is explicitly backfilled to
  /// SELF_MANAGED by this migration's own SQL (see the migration file), not
  /// left to an implicit default that future inserts might accidentally
  /// rely on instead of setting explicitly.
  managementMode    StudentManagementMode
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  /// onDelete: SetNull (changed from Cascade — Phase H.1): a StudentProfile
  /// now legitimately outlives its linked User (a GUARDIAN_MANAGED profile
  /// can exist with userId already null; this makes the reverse direction
  /// consistent — losing the User account degrades this profile back to
  /// that same "no login" state rather than destroying booking/payment
  /// history attached to it).
  user                User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  academicLevel       AcademicLevel?              @relation(fields: [academicLevelId], references: [id])
  parentRelationships ParentStudentRelationship[]
  learningGoals       LearningGoal[]
  favorites           TutorFavorite[]
  bookings            Booking[]
  reviews             Review[]
  priceQuotes         CustomerPriceQuote[]
  tutoringRequests    TutoringRequest[]
  familyInvitations   FamilyInvitation[]
  consentRecords      ConsentRecord[]
}

model ParentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  firstName         String
  lastName          String
  preferredLanguage String   @default("en")
  province          String?
  city              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentRelationships ParentStudentRelationship[]
}

/// Phase H.1 — see the Phase H planning report's "Guardian Relationship
/// Lifecycle" section. status/reactivation: a REVOKED row is reactivated in
/// place (status flips back to ACTIVE) rather than a second row ever being
/// inserted for the same (parentProfileId, studentProfileId) pair — the
/// @@unique below is what makes a duplicate-insert attempt fail, by design.
/// onDelete on the two subject FKs is Restrict (changed from the Phase A/B
/// original Cascade, which was never exercised — this table has zero rows
/// in every environment prior to Phase H): once this table is live and
/// historically significant, a ParentProfile/StudentProfile must never be
/// able to silently cascade-delete guardian-relationship history.
enum GuardianRelationshipStatus {
  ACTIVE
  REVOKED
}

model ParentStudentRelationship {
  id               String                     @id @default(cuid())
  parentProfileId  String
  studentProfileId String
  relationshipType String                     @default("PARENT")
  status           GuardianRelationshipStatus @default(ACTIVE)
  /// Actor pointers, not the subject of the historical record itself —
  /// SetNull (not Restrict) if the actor User is ever removed: the fact
  /// that the relationship existed/was revoked is preserved, only "who
  /// performed it" degrades gracefully. No isPrimaryPayer field — removed
  /// during architecture review; Payment.payerUserId is the sole
  /// authoritative per-transaction payer, no default-guardian concept is
  /// needed.
  createdByUserId  String?
  revokedAt        DateTime?
  revokedByUserId  String?
  createdAt        DateTime                   @default(now())

  parentProfile  ParentProfile   @relation(fields: [parentProfileId], references: [id], onDelete: Restrict)
  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  createdByUser  User?           @relation("GuardianRelationshipCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  revokedByUser  User?           @relation("GuardianRelationshipRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  consentRecords ConsentRecord[]

  @@unique([parentProfileId, studentProfileId])
  @@index([studentProfileId, status])
}

model LearningGoal {
  id               String   @id @default(cuid())
  studentProfileId String
  subjectId        String?
  description      String
  createdAt        DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject        Subject?       @relation(fields: [subjectId], references: [id])
}

// ---------------------------------------------------------------------------
// Family Accounts & Student Foundation (Phase H.1 — schema/domain foundation
// only; the application behavior that consumes these structures — the
// authorization policy layer, invitation token generation, claim/approval
// Server Actions, onboarding UX — is later Phase H sub-phase work, not built
// here. See FutureTutor_Phase_H_Planning_Report.md for the full design.
// ---------------------------------------------------------------------------

enum FamilyInvitationType {
  STUDENT_LOGIN
  GUARDIAN_LINK
}

/// Two-party activation state machine — see the planning report's
/// "FamilyInvitation — Two-Party Activation" section. Reaching
/// CLAIMED_PENDING_APPROVAL grants zero family/student access on its own;
/// only an explicit, separately-authorized guardian's approval (the
/// ACCEPTED transition) does. This closes the gap where a leaked invitation
/// link, even combined with the correct intended email, could otherwise
/// grant access without any independently-authorized human approving it.
enum FamilyInvitationStatus {
  PENDING
  CLAIMED_PENDING_APPROVAL
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Phase H.1 — schema only; token generation, the claim flow, and the
/// approval flow (including re-verifying the approving guardian's CURRENT
/// active authority) are H.4/H.5 application work. tokenHash is a hash, the
/// plaintext token is never persisted. invitedEmailNormalized is the
/// guardian-declared intended recipient, bound at claim/approval time by
/// application logic — explicitly documented (in the planning report) as
/// email-binding, not verified mailbox ownership, since no
/// email-verification infrastructure exists in this codebase yet.
model FamilyInvitation {
  id                     String                 @id @default(cuid())
  type                   FamilyInvitationType
  targetStudentProfileId String
  invitedEmailNormalized String
  invitedByUserId        String?
  tokenHash              String                 @unique
  status                 FamilyInvitationStatus @default(PENDING)
  claimedByUserId        String?
  claimedAt              DateTime?
  approvedByUserId       String?
  approvedAt             DateTime?
  expiresAt              DateTime
  createdAt              DateTime               @default(now())

  targetStudentProfile StudentProfile @relation(fields: [targetStudentProfileId], references: [id], onDelete: Cascade)
  invitedByUser        User?          @relation("FamilyInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  claimedByUser        User?          @relation("FamilyInvitationClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  approvedByUser       User?          @relation("FamilyInvitationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([targetStudentProfileId, type, status])
}

/// Phase H.1 — structural hooks only; no consent-gating logic exists yet and
/// no legal policy is decided by this model's existence. Real FKs
/// throughout (never a polymorphic subjectType/subjectId) — see the
/// planning report's "Consent Foundation" section. actorUserId/
/// studentProfileId/guardianRelationshipId all use Restrict: consent is the
/// clearest legal/audit-history case in this schema, and must never
/// silently disappear via a cascade from any direction. The CHECK
/// constraint (guardianRelationshipId set implies studentProfileId set) is
/// added via hand-edited migration SQL, since Prisma's schema DSL has no
/// native multi-field CHECK syntax.
model ConsentRecord {
  id                     String    @id @default(cuid())
  actorUserId            String
  studentProfileId       String?
  guardianRelationshipId String?
  consentType            String
  policyVersion          String
  grantedAt              DateTime  @default(now())
  revokedAt              DateTime?
  sourceContext          String
  createdAt              DateTime  @default(now())

  actorUser            User                       @relation("ConsentActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  studentProfile       StudentProfile?            @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  guardianRelationship ParentStudentRelationship? @relation(fields: [guardianRelationshipId], references: [id], onDelete: Restrict)

  @@index([studentProfileId])
  @@index([actorUserId])
}

// ---------------------------------------------------------------------------
// Tutor (Phase A creates the table + registration row; everything else
// filled in during Phase B onboarding).
// ---------------------------------------------------------------------------

enum TutorApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_REQUIRED
  INTERVIEW_COMPLETED
  TRAINING_REQUIRED
  TRAINING_COMPLETED
  EXAM_REQUIRED
  EXAM_COMPLETED
  FINAL_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum StripeConnectStatus {
  NOT_STARTED
  PENDING
  RESTRICTED
  ACTIVE
  DISABLED
}

// Placeholder tier names (Phase E) — never shown publicly. A simple, explicit,
// admin-set field, not derived from TutorScore/session history/public rating —
// there isn't enough marketplace history yet to justify an automated tier.
enum TutorTier {
  NEW
  VERIFIED
  SENIOR
  ELITE
}

model TutorProfile {
  id                            String                 @id @default(cuid())
  userId                        String                 @unique
  slug                          String                 @unique
  headline                      String?
  bio                           String?                @db.Text
  yearsExperience               Int?
  /// @deprecated Kept only for Phase C booking-flow compatibility. FutureTutor's
  /// business model does not let tutors set the customer price — a dedicated
  /// Customer Price Engine / Tutor Payout Engine replaces this field in the
  /// phase immediately after Tutor Validation Depth. Do not build new features
  /// that treat this as a quality/tier signal or a permanent tutor capability.
  hourlyRateCents               Int?
  currency                      String                 @default("CAD")
  applicationStatus             TutorApplicationStatus @default(DRAFT)
  /// null = not yet approved under either process; 1 = approved under the old
  /// simplified process (historical, not retroactively changed); 2 = approved
  /// under the full Tutor Validation Depth pipeline.
  validationVersion             Int?
  // Phase E — simple explicit payout tier, see TutorTier enum comment.
  payoutTier                    TutorTier              @default(NEW)
  learningMode                  TutoringMode?
  city                          String?
  province                      String?
  travelRadiusKm                Int?
  latitude                      Float?
  longitude                     Float?
  ratingAverage                 Float                  @default(0)
  reviewCount                   Int                    @default(0)
  stripeConnectAccountId        String?
  stripeConnectStatus           StripeConnectStatus    @default(NOT_STARTED)
  /// PROD-CONNECT-RETRYFIX1 — participates in the Connect account-creation
  /// idempotency key (`connect-account:${tutorProfileId}:${epoch}`).
  /// Advances only after a confirmed pre-creation Stripe rejection
  /// (StripeInvalidRequestError from accounts.create — proven nothing was
  /// created); never on network/5xx/ambiguous outcomes, and never once
  /// stripeConnectAccountId is set. See ensureConnectAccount.
  stripeConnectAttemptEpoch     Int                    @default(0)
  /// FG-LEGAL2 — Tutor Independent Service Provider Agreement acceptance
  /// record. Mirrors User.termsAcceptedAt/Version/Locale's shape (see
  /// migration 20260828213506_add_terms_acceptance_record) but lives here
  /// since only Tutors need it. Never backfilled for tutors approved before
  /// this field existed — see submitApplication's gate and the dashboard
  /// re-acceptance banner for already-APPROVED tutors.
  tutorAgreementAcceptedAt      DateTime?
  tutorAgreementAcceptedVersion String?
  tutorAgreementAcceptedLocale  String?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt

  user                     User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects                 TutorSubject[]
  levels                   TutorLevel[]
  languages                TutorLanguage[]
  education                TutorEducation[]
  certifications           TutorCertification[]
  availability             TutorAvailability[]
  availabilityExceptions   TutorAvailabilityException[]
  verifications            TutorVerification[]
  media                    TutorMedia[]
  documents                TutorDocument[]
  interviews               TutorInterview[]
  trainingProgress         TutorTrainingProgress[]
  examAttempts             TutorExamAttempt[]
  scores                   TutorScore[]
  scoreSnapshots           TutorScoreSnapshot[]
  bookings                 Booking[]
  favoritedBy              TutorFavorite[]
  reviews                  Review[]
  payoutQuotes             TutorPayoutQuote[]
  invitations              TutorInvitation[]
  earnings                 TutorEarning[]
  transfers                TutorTransfer[]
  applicationNotifications TutorApplicationNotification[]

  @@index([applicationStatus])
  @@index([city, province])
}

model TutorSubject {
  id             String @id @default(cuid())
  tutorProfileId String
  subjectId      String

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, subjectId])
  @@index([subjectId])
}

model TutorLevel {
  id              String @id @default(cuid())
  tutorProfileId  String
  academicLevelId String

  tutorProfile  TutorProfile  @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  academicLevel AcademicLevel @relation(fields: [academicLevelId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, academicLevelId])
}

model TutorLanguage {
  id             String @id @default(cuid())
  tutorProfileId String
  language       String // ISO code: "en" | "fr" | ...

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, language])
}

enum QualificationVerificationStatus {
  UNVERIFIED
  VERIFIED
}

model TutorEducation {
  id                   String                          @id @default(cuid())
  tutorProfileId       String
  institution          String
  degree               String?
  fieldOfStudy         String?
  startYear            Int?
  endYear              Int?
  verificationStatus   QualificationVerificationStatus @default(UNVERIFIED)
  verifiedByDocumentId String?
  // Admin judgment made on the qualification record itself (at verification
  // time, against a supporting document) — not derived from document count
  // or any automated field-of-study text matching. See TutorScoring service.
  isRelevantToSubjects Boolean?

  tutorProfile      TutorProfile   @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  verifyingDocument TutorDocument? @relation(fields: [verifiedByDocumentId], references: [id])
}

model TutorCertification {
  id                   String                          @id @default(cuid())
  tutorProfileId       String
  name                 String
  issuer               String?
  issueYear            Int?
  credentialUrl        String?
  verificationStatus   QualificationVerificationStatus @default(UNVERIFIED)
  verifiedByDocumentId String?
  isRelevantToSubjects Boolean?

  tutorProfile      TutorProfile   @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  verifyingDocument TutorDocument? @relation(fields: [verifiedByDocumentId], references: [id])
}

model TutorAvailability {
  id             String       @id @default(cuid())
  tutorProfileId String
  dayOfWeek      Int // 0 = Sunday .. 6 = Saturday
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"
  timezone       String // IANA, e.g. "America/Toronto"
  mode           TutoringMode @default(BOTH)

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId, dayOfWeek])
}

model TutorAvailabilityException {
  id             String   @id @default(cuid())
  tutorProfileId String
  date           DateTime
  isAvailable    Boolean
  startTime      String?
  endTime        String?
  reason         String?

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId, date])
}

enum VerificationType {
  IDENTITY
  EDUCATION
  CERTIFICATION
  BACKGROUND_CHECK
  MANUAL_ADMIN_REVIEW
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model TutorVerification {
  id             String             @id @default(cuid())
  tutorProfileId String
  type           VerificationType
  status         VerificationStatus @default(PENDING)
  provider       String?
  reference      String?
  submittedAt    DateTime?
  verifiedAt     DateTime?
  expiresAt      DateTime?
  notes          String?

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
}

model TutorMedia {
  id             String   @id @default(cuid())
  tutorProfileId String
  type           String // "PHOTO" | "DOCUMENT"
  url            String
  createdAt      DateTime @default(now())

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Tutor Validation Depth (Phase D). TutorDocument is private evidence that
// *verifies* a TutorEducation/TutorCertification row — the scoring service
// reads verified qualification records, never document counts. All status
// transitions on TutorProfile.applicationStatus flow exclusively through
// src/services/tutorApplicationWorkflow.ts.
// ---------------------------------------------------------------------------

enum TutorDocumentType {
  TRANSCRIPT
  DIPLOMA
  DEGREE
  CERTIFICATE
  ENROLLMENT_PROOF
  OTHER
}

enum TutorDocumentStatus {
  UPLOADED
  PENDING_REVIEW
  APPROVED
  REJECTED
  REPLACEMENT_REQUIRED
}

model TutorDocument {
  id               String              @id @default(cuid())
  tutorProfileId   String
  type             TutorDocumentType
  // Server-generated (crypto.randomUUID()) — never derived from user input,
  // which eliminates path-traversal by construction.
  storageKey       String              @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  status           TutorDocumentStatus @default(UPLOADED)
  uploadedAt       DateTime            @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  rejectionReason  String?
  adminNotes       String?

  tutorProfile           TutorProfile         @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  verifiedEducations     TutorEducation[]
  verifiedCertifications TutorCertification[]

  @@index([tutorProfileId, status])
}

enum TutorInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model TutorInterview {
  id                String               @id @default(cuid())
  tutorProfileId    String
  scheduledAt       DateTime?
  completedAt       DateTime?
  interviewerUserId String?
  status            TutorInterviewStatus @default(SCHEDULED)
  overallNotes      String?              @db.Text

  tutorProfile TutorProfile               @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  evaluations  TutorInterviewEvaluation[]

  @@index([tutorProfileId, status])
