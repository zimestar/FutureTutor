// ---------------------------------------------------------------------------
// Bookings (Phase C)
// ---------------------------------------------------------------------------

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
  NO_SHOW
  REFUNDED
  RESCHEDULED
}

model Booking {
  id                       String        @id @default(cuid())
  studentProfileId         String
  tutorProfileId           String
  subjectId                String
  academicLevelId          String?
  startAt                  DateTime
  // Scheduled contractual end time — commercial, never adjusted post-
  // creation, never extended by a late arrival. Session_.completedAt (see
  // below) is the separate, operational "did it actually finish" fact.
  endAt                    DateTime
  timezone                 String
  mode                     TutoringMode
  locationNote             String?
  /// @deprecated Legacy Phase C snapshot of the tutor's own rate. Nullable
  /// since Phase E — existing rows keep their historical value untouched;
  /// new bookings no longer populate it (see customerBasePriceCents etc.
  /// below, sourced from CustomerPriceQuote/TutorPayoutQuote instead).
  hourlyRateCentsSnapshot  Int?
  platformFeeCentsSnapshot Int
  currency                 String        @default("CAD")
  totalCents               Int
  status                   BookingStatus @default(DRAFT)
  notes                    String?
  cancelledByUserId        String?
  cancelledAt              DateTime?
  cancellationReason       String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  // --- Phase E financial snapshot (nullable — legacy Phase C bookings have
  // none of these; every new booking sets them from the consumed quotes) ---
  customerPriceQuoteId       String?
  tutorPayoutQuoteId         String?
  customerBasePriceCents     Int?
  customerAdjustmentCents    Int?
  customerSubtotalCents      Int?
  taxCents                   Int?
  tutorPayoutBaseCents       Int?
  tutorPayoutAdjustmentCents Int?
  tutorPayoutCents           Int?
  grossSpreadCents           Int?
  customerPricingVersion     String?
  tutorPayoutVersion         String?

  // --- Phase F (Quick Match) — nullable, direct/Browse-Tutors bookings
  // (Phase C/E) leave all six of these null; only Quick Match bookings
  // populate them. tutoringRequestId traces a booking back to the request
  // that produced it. The five location fields are an authoritative
  // snapshot, independent of any later change to the source TutoringRequest
  // — the same "snapshot, don't reference-and-hope" principle Phase E
  // already used for pricing. locationNote (above) stays a separate,
  // free-text supplementary field (e.g. "buzz #402"), not the authoritative
  // address.
  tutoringRequestId          String?
  bookingAddressLine1        String?
  bookingAddressLine2        String?
  bookingCity                String?
  bookingProvince            String?
  bookingPostalCode          String?
  // BETA-IP1-C — same snapshot principle as the five fields above, for the
  // TutoringRequest.arrivalInstructions this Booking was claimed against.
  // Immutable once set; a later edit to a (currently nonexistent) saved
  // location can never retroactively change an already-snapshotted Booking.
  bookingArrivalInstructions String?

  studentProfile     StudentProfile             @relation(fields: [studentProfileId], references: [id])
  tutorProfile       TutorProfile               @relation(fields: [tutorProfileId], references: [id])
  subject            Subject                    @relation(fields: [subjectId], references: [id])
  academicLevel      AcademicLevel?             @relation(fields: [academicLevelId], references: [id])
  customerPriceQuote CustomerPriceQuote?        @relation(fields: [customerPriceQuoteId], references: [id])
  tutorPayoutQuote   TutorPayoutQuote?          @relation(fields: [tutorPayoutQuoteId], references: [id])
  tutoringRequest    TutoringRequest?           @relation(fields: [tutoringRequestId], references: [id])
  winningInvitation  TutorInvitation?
  statusHistory      BookingStatusHistory[]
  session            Session_?
  payment            Payment?
  earning            TutorEarning?
  refunds            Refund[]
  review             Review?
  conversation       Conversation?
  emailNotifications BookingEmailNotification[]

  @@index([studentProfileId])
  @@index([tutorProfileId])
  @@index([startAt])
  @@index([status])
  @@index([tutorProfileId, startAt])
  @@index([tutoringRequestId])
}

model BookingStatusHistory {
  id              String         @id @default(cuid())
  bookingId       String
  fromStatus      BookingStatus?
  toStatus        BookingStatus
  changedByUserId String?
  reason          String?
  createdAt       DateTime       @default(now())

  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedByUser User?   @relation("BookingStatusChangedBy", fields: [changedByUserId], references: [id])
}

// VIDEO-1A — the video-call provider a Session_'s room (if any) was
// provisioned through. A typed enum rather than an arbitrary String: today
// there is exactly one implemented adapter (Daily), but the whole point of
// the provider-abstraction layer (src/services/videoProvider.ts) is that a
// future provider swap must not require rewriting session authorization/
// business logic — an enum keeps that swap a one-line addition here plus a
// new adapter, rather than an unconstrained string every call site would
// need to defensively re-validate.
enum VideoProvider {
  DAILY
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
  // Session Lifecycle Phase 4: a session that successfully reached
  // IN_PROGRESS but terminated early through an explicit, authorized actor
  // request (requestSessionInterruption, src/services/sessionLifecycle.ts)
  // rather than running to its normal contractual end. Distinct from
  // COMPLETED (ran to a normal end) and NO_SHOW (never established
  // presence) — never overload either to mean this. Reachable ONLY from
  // IN_PROGRESS; every other transition into this value is rejected.
  INTERRUPTED
}

// Named Session_ to avoid clashing with NextAuth's own `Session` model above
// — this one is the tutoring event, not an auth session.
model Session_ {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  startedAt         DateTime?
  // Session Lifecycle Phase 4: the authoritative, server-generated
  // timestamp of an early/abnormal termination — written ONLY by
  // requestSessionInterruption alongside status -> INTERRUPTED, never for a
  // normal COMPLETED end (see completedAt below). Deliberately kept as a
  // separate, non-overlapping field from completedAt rather than one field
  // overloaded to mean "terminal timestamp regardless of outcome" — exactly
  // one of endedAt/completedAt is ever non-null for a given terminal
  // Session_ row.
  endedAt           DateTime?
  status            SessionStatus @default(SCHEDULED)
  tutorAttendance   Boolean?
  studentAttendance Boolean?
  onlineMeetingUrl  String?
  notes             String?       @db.Text
  // Session Lifecycle Phase 4: the authoritative, server-generated
  // timestamp of successful operational completion — written ONLY by
  // resolveSessionCompletionConvergence (src/services/sessionLifecycle.ts)
  // alongside status -> COMPLETED, at/after Booking.endAt. Distinct from
  // Booking.endAt (the scheduled contractual end time, never adjusted) and
  // from endedAt (the separate INTERRUPTED-only terminal timestamp above) —
  // never overload either to mean this.
  completedAt       DateTime?
  // Phase 5A (Financial Schema Foundation): the authoritative, server-
  // generated timestamp of when FutureTutor actually DETERMINED a no-show
  // outcome — written ONLY by the same guarded updateMany inside
  // applyNoShowConvergenceIfDue (src/services/sessionLifecycle.ts) that
  // performs the SCHEDULED -> NO_SHOW transition, atomically with it. Never
  // written when convergence is not yet due, not applicable, or the Session
  // already reached another terminal state; never overwritten by a
  // subsequent no-op convergence call (the same `where: { status:
  // "SCHEDULED" }` guard that protects the status write also protects this
  // field, since both are set in the same `data` object of the same
  // `updateMany`). Conceptually distinct from graceDeadlineAt (Booking.
  // startAt + 15min — a computed threshold, not a recorded event) and from
  // completedAt/endedAt above — never overload any of them to mean this.
  // Intended future eligibility anchor for STUDENT_NO_SHOW compensation:
  // noShowConvergedAt + 24h (see TutorEarning.eligibleAt's comment) — not
  // yet implemented as of Phase 5A.
  noShowConvergedAt DateTime?

  // VIDEO-1A — provider-room persistence. Deliberately NOT a new
  // TutoringSession model: Session_ already IS the 1:1-with-Booking session-
  // lifecycle entity a video room belongs to (see the VIDEO-0 architecture
  // report). All three fields are nullable together — null until the
  // provisioning sweep (src/services/videoSession.ts) creates the room at
  // Booking.startAt - 15min, matching CHECK_IN_WINDOW_MINUTES_BEFORE_START.
  // providerRoomId is an internal reference only — NEVER an authorization
  // mechanism on its own (see videoJoinAuthorization.ts); knowing it grants
  // nothing without a server-issued, participant-scoped token. Deliberately
  // does NOT repurpose the pre-existing onlineMeetingUrl field below, which
  // is the wrong shape for this (a raw client-facing URL would itself become
  // a bearer credential) and stays unused/legacy.
  videoProvider  VideoProvider?
  providerRoomId String?        @unique
  roomCreatedAt  DateTime?

  booking          Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  attendanceEvents SessionAttendanceEvent[]

  @@map("Session_tutoring")
}

// ---------------------------------------------------------------------------
// Session Lifecycle Phase 2 — Attendance/check-in foundation. ATTENDANCE ONLY:
// no no-show determination, no incidents/disputes, no automatic completion, no
// TutorEarning/financial effect. See
// FutureTutor_SessionLifecycle_Phase2_Implementation_Report.md for the full
// design rationale.
// ---------------------------------------------------------------------------

/// Whose physical presence a SessionAttendanceEvent represents — NOT who
/// performed the action (see SessionAttendanceEvent.recordedByUserId for
/// that). A Tutor may record that a Student is present (participantRole =
/// STUDENT, recordedByUserId = the Tutor's own User id) — the subject and
/// the actor are deliberately independent fields, never conflated.
enum SessionParticipantRole {
  TUTOR
  STUDENT
}

/// CHECK_IN is the only event type with a writer in Phase 2. CHECK_OUT is
/// declared now (schema-complete per the approved design) but deliberately
/// has no writer yet — recording checkout is evidence-only and adds no
/// Phase 2 capability (nothing reads it), so implementing it now would be
/// speculative scope; see the Phase 2 report's "Check-out" section for the
/// explicit deferral decision. Never let a future CHECK_OUT writer trigger a
/// state transition on its own (that decision belongs to a later phase).
enum SessionAttendanceEventType {
  CHECK_IN
  CHECK_OUT
}

/// IN_PERSON_MANUAL is the only source with a writer in Phase 2 — a
/// participant (or, for a represented learner, an authorized actor) taps
/// "I am here" and the server stamps occurredAt; no GPS, no photo, no QR
/// (approved rule B). ONLINE_ACTIVITY is reserved for a future phase that
/// derives presence from authenticated in-app session activity (rule B's
/// "eventually" framing) — declared here only so the evidence-row shape
/// never needs a breaking change when that phase lands; no code path
/// produces it in Phase 2.
enum SessionAttendanceSource {
  IN_PERSON_MANUAL
  ONLINE_ACTIVITY
}

/// Append-only presence evidence. Never updated, never deleted by
/// application code — a later CHECK_IN is a NEW row, not a rewrite of an
/// earlier one, so a full presence history always remains reconstructable
/// for a future dispute (see FutureTutor_Session_Lifecycle_Architecture_Audit.md
/// §21). Deliberately NOT unique on (sessionId, participantRole, eventType):
/// the concurrency-safety mechanism for "only one IN_PROGRESS transition" is
/// the guarded Session_.status updateMany in sessionLifecycle.ts, not a
/// row-level uniqueness constraint here — a uniqueness constraint would
/// additionally have to special-case legitimate repeat/reconnect check-ins,
/// which the append-only design explicitly wants to allow (§6 of the Phase 2
/// task spec). Duplicate CHECK_IN rows for the same participant are harmless:
/// "has this participant checked in at all" is derived from row EXISTENCE,
/// not row COUNT or uniqueness.
model SessionAttendanceEvent {
  id               String                     @id @default(cuid())
  sessionId        String
  /// Whose presence this row represents — TUTOR or STUDENT. See the enum's
  /// own doc comment for the subject-vs-actor distinction.
  participantRole  SessionParticipantRole
  /// Who performed the declaration (authenticated actor) — the Tutor
  /// themselves for their own check-in; the Student, an authorized Guardian,
  /// or the owning Tutor (declaring learner presence) for a STUDENT-role
  /// event. SetNull (not Restrict), mirroring
  /// ParentStudentRelationship.createdByUserId's established precedent for
  /// actor pointers: the row is a historical presence record, not the actor's
  /// own data — losing the User account degrades "who performed it" without
  /// destroying the evidence itself.
  recordedByUserId String?
  eventType        SessionAttendanceEventType
  /// Authoritative server-generated timestamp — ALWAYS the server clock()
  /// evaluated at write time inside the authoritative transaction, NEVER a
  /// client-supplied value. See sessionLifecycle.ts's clock() parameter and
  /// the forged-timestamp regression tests.
  occurredAt       DateTime
  source           SessionAttendanceSource
  createdAt        DateTime                   @default(now())

  session        Session_ @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recordedByUser User?    @relation("SessionAttendanceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([sessionId, participantRole, eventType, occurredAt])
}

// ---------------------------------------------------------------------------
// Pricing & Payouts (Phase E — Customer Price Engine + Tutor Payout Engine).
// Two independent, versioned, auditable financial engines: one decides what
// the customer pays, one decides what the tutor earns. Never a fixed
// percentage of each other — see src/services/customerPricing.ts and
// src/services/tutorPayout.ts for the calculation order.
// ---------------------------------------------------------------------------

model CustomerBasePriceRule {
  id                  String    @id @default(cuid())
  // null = wildcard, used for rule-priority fallback resolution.
  subjectId           String?
  academicLevelId     String?
  baseDurationMinutes Int
  basePriceCents      Int
  currency            String    @default("CAD")
  effectiveFrom       DateTime  @default(now())
  effectiveUntil      DateTime?
  isActive            Boolean   @default(true)
  pricingVersion      String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  subject       Subject?             @relation(fields: [subjectId], references: [id])
  academicLevel AcademicLevel?       @relation(fields: [academicLevelId], references: [id])
  quotes        CustomerPriceQuote[]

  @@index([subjectId, academicLevelId, isActive])
}

model TutorBasePayoutRule {
  id                  String    @id @default(cuid())
  tutorTier           TutorTier
  subjectId           String?
  academicLevelId     String?
  baseDurationMinutes Int
  payoutCents         Int
  currency            String    @default("CAD")
  isActive            Boolean   @default(true)
  effectiveFrom       DateTime  @default(now())
  effectiveUntil      DateTime?
  payoutVersion       String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  subject       Subject?           @relation(fields: [subjectId], references: [id])
  academicLevel AcademicLevel?     @relation(fields: [academicLevelId], references: [id])
  quotes        TutorPayoutQuote[]

  @@index([tutorTier, subjectId, academicLevelId, isActive])
}

// Single-row (singleton) typed settings — a handful of scalar tuning knobs,
// deliberately not a generic key-value/JSON config table (that pattern is
// reserved for CustomerBasePriceRule/TutorBasePayoutRule's real relational
// rules). Mutated in place; configVersion is what lets a quote record which
// settings state produced it.
model MarketplacePricingSettings {
  id                               String   @id @default(cuid())
  quoteTtlMinutes                  Int      @default(15)
  urgencyShortNoticeThresholdHours Int      @default(48)
  urgencyShortNoticeAmountCents    Int      @default(300)
  urgencyUrgentThresholdHours      Int      @default(24)
  urgencyUrgentAmountCents         Int      @default(600)
  lowSupplyThresholdCount          Int      @default(2)
  lowSupplyAmountCents             Int      @default(400)
  tutorUrgencyBonusCents           Int      @default(400)
  minimumGrossSpreadCents          Int      @default(0)
  configVersion                    String   @default("MARKETPLACE_SETTINGS_V1")
  updatedAt                        DateTime @updatedAt
  updatedByUserId                  String?
}

enum CustomerQuoteStatus {
  ACTIVE
  // Phase F (Quick Match) — the student has confirmed this exact price for a
  // TutoringRequest; it is now immutable and never recalculated. expiresAt is
  // no longer checked once LOCKED — only the parent TutoringRequest's own
  // lifecycle governs whether this quote may still reach CONSUMED. Direct
  // booking (Phase C/E) never passes through this state (ACTIVE -> CONSUMED
  // directly), since it has no confirm-then-match gap for LOCKED to bridge.
  LOCKED
  EXPIRED
  CONSUMED
  CANCELLED
}

model CustomerPriceQuote {
  id                       String              @id @default(cuid())
  // The authenticated actor who requested the quote (may be a parent booking
  // for a child later) — distinct from studentProfileId, the beneficiary.
  createdByUserId          String
  studentProfileId         String
  subjectId                String
  academicLevelId          String?
  tutoringMode             TutoringMode
  durationMinutes          Int
  requestedStartAt         DateTime
  currency                 String              @default("CAD")
  basePriceCents           Int
  basePriceRuleId          String
  basePriceRuleVersion     String
  adjustmentsTotalCents    Int
  subtotalCents            Int
  taxCents                 Int
  taxConfigured            Boolean             @default(false)
  totalCents               Int
  pricingVersion           String
  marketplaceConfigVersion String
  contextHash              String
  breakdown                Json
  contextSnapshot          Json
  status                   CustomerQuoteStatus @default(ACTIVE)
  createdAt                DateTime            @default(now())
  expiresAt                DateTime
  // Phase F — set once, when status moves ACTIVE -> LOCKED (the student
  // confirmed a TutoringRequest). expiresAt is never consulted again after
  // this is set; see the CustomerQuoteStatus.LOCKED comment above.
  lockedAt                 DateTime?
  consumedAt               DateTime?
  cancelledAt              DateTime?

  createdByUser    User                  @relation(fields: [createdByUserId], references: [id])
  studentProfile   StudentProfile        @relation(fields: [studentProfileId], references: [id])
  subject          Subject               @relation(fields: [subjectId], references: [id])
  academicLevel    AcademicLevel?        @relation(fields: [academicLevelId], references: [id])
  basePriceRule    CustomerBasePriceRule @relation(fields: [basePriceRuleId], references: [id])
  payoutQuotes     TutorPayoutQuote[]
  bookings         Booking[]
  tutoringRequests TutoringRequest[]
  payment          Payment?

  @@index([createdByUserId, status])
  @@index([studentProfileId, status])
  @@index([expiresAt])
}

enum TutorPayoutQuoteStatus {
  ACTIVE
  EXPIRED
  ACCEPTED
  CONSUMED
  DECLINED
  SUPERSEDED
  CANCELLED
}

model TutorPayoutQuote {
  id                       String                 @id @default(cuid())
  tutorProfileId           String
  customerPriceQuoteId     String
  subjectId                String
  academicLevelId          String?
  tutoringMode             TutoringMode
  durationMinutes          Int
  requestedStartAt         DateTime
  currency                 String                 @default("CAD")
  basePayoutCents          Int
  basePayoutRuleId         String
  basePayoutRuleVersion    String
  tutorTierAtCalculation   TutorTier
  adjustmentsTotalCents    Int
  totalPayoutCents         Int
  payoutVersion            String
  marketplaceConfigVersion String
  breakdown                Json
  status                   TutorPayoutQuoteStatus @default(ACTIVE)
  createdAt                DateTime               @default(now())
  expiresAt                DateTime
  acceptedAt               DateTime?
  consumedAt               DateTime?
  declinedAt               DateTime?
  cancelledAt              DateTime?

  tutorProfile       TutorProfile        @relation(fields: [tutorProfileId], references: [id])
  customerPriceQuote CustomerPriceQuote  @relation(fields: [customerPriceQuoteId], references: [id])
  subject            Subject             @relation(fields: [subjectId], references: [id])
  academicLevel      AcademicLevel?      @relation(fields: [academicLevelId], references: [id])
  basePayoutRule     TutorBasePayoutRule @relation(fields: [basePayoutRuleId], references: [id])
  bookings           Booking[]
  invitations        TutorInvitation[]

  @@index([tutorProfileId, status])
  @@index([customerPriceQuoteId])
}

// ---------------------------------------------------------------------------
// Quick Match & Tutor Dispatch (Phase F). Orchestration layer on top of the
// Customer Price Engine / Tutor Payout Engine above — a TutoringRequest's
// price is locked (CustomerPriceQuote LOCKED) at confirmation, before
// matching starts, so a multi-round dispatch process can never change what
// the student was told they'd pay. A TutorInvitation is both the per-tutor
// dispatch attempt and its own audit record (rankScore/rankBreakdown) — no
// separate MatchingAttempt/DispatchAttempt table exists. Direct booking
// (Phase C/E, "Browse Tutors") is untouched by any of this; both flows share
// one booking-creation core (see src/services/bookingCreation.ts).
// ---------------------------------------------------------------------------

enum TutoringRequestStatus {
  DRAFT
  PRICED
  CONFIRMED
  MATCHING
  // Phase G — a tutor has locally claimed the win (Step A: invitation
  // ACCEPTED, competing invitations SUPERSEDED, a PENDING_PAYMENT Booking
  // reserved) but Stripe capture has not yet resolved. Sits between
  // MATCHING and BOOKED.
  PAYMENT_PENDING
  BOOKED
  CANCELLED
  EXPIRED
  NO_TUTOR_FOUND
  // Genuine unexpected server error during acceptance — unchanged from
  // Phase F, still distinct from PAYMENT_FAILED below (a specific,
  // well-understood outcome, not a catch-all).
  FAILED
  // Phase G — reached only from PAYMENT_PENDING when capture definitively
  // fails (see convergeToCaptureFailed in src/services/payments.ts). A
  // request-level outcome, not a candidate-level one — the customer's
  // payment is the blocker, not this tutor's availability, so dispatch
  // does not continue to another candidate.
  PAYMENT_FAILED
}

model TutoringRequest {
  id                  String       @id @default(cuid())
  createdByUserId     String
  studentProfileId    String
  subjectId           String
  academicLevelId     String?
  tutoringMode        TutoringMode
  durationMinutes     Int
  requestedStartAt    DateTime
  // Request location (private, full precision) — required by
  // src/schemas/tutoringRequest.ts whenever tutoringMode !== ONLINE;
  // addressLine1/addressLine2/postalCode stay null for ONLINE requests.
  // Never copied onto TutorInvitation — see TutorInvitation's own comment.
  addressLine1        String?
  addressLine2        String?
  city                String?
  province            String?
  postalCode          String?
  // BETA-IP1-C — optional free-text arrival guidance (e.g. "use the side
  // entrance", "ring apartment 302"). Same privacy tier as the address
  // fields above: private, never copied onto TutorInvitation, only ever
  // disclosed to the winning Tutor via the Booking snapshot below once the
  // Booking reaches an access-granting state (src/services/
  // bookingLocationAccess.ts). Always null for ONLINE requests.
  arrivalInstructions String?
  notes               String?
  currency            String       @default("CAD")

  // Locked price snapshot — filled in when the linked CustomerPriceQuote
  // moves ACTIVE -> LOCKED (PRICED -> CONFIRMED). Null before then.
  customerPriceQuoteId  String?
  basePriceCents        Int?
  adjustmentsTotalCents Int?
  taxCents              Int?
  totalCents            Int?
  pricingVersion        String?

  status        TutoringRequestStatus @default(DRAFT)
  dispatchRound Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  confirmedAt   DateTime?
  bookedAt      DateTime?
  cancelledAt   DateTime?

  createdByUser      User                @relation(fields: [createdByUserId], references: [id])
  studentProfile     StudentProfile      @relation(fields: [studentProfileId], references: [id])
  subject            Subject             @relation(fields: [subjectId], references: [id])
  academicLevel      AcademicLevel?      @relation(fields: [academicLevelId], references: [id])
  customerPriceQuote CustomerPriceQuote? @relation(fields: [customerPriceQuoteId], references: [id])
  invitations        TutorInvitation[]
  bookings           Booking[]

  @@index([createdByUserId, status])
  @@index([studentProfileId, status])
  @@index([status])
}

enum TutorInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  SUPERSEDED
}

model TutorInvitation {
  id                 String                @id @default(cuid())
  tutoringRequestId  String
  tutorProfileId     String
  tutorPayoutQuoteId String?
  dispatchRound      Int
  isParallelRound    Boolean               @default(false)
  status             TutorInvitationStatus @default(PENDING)
  // Snapshot of the ranking decision that produced this dispatch — every
  // invitation is independently explainable after the fact. Deliberately
  // does NOT carry the request's address (see TutoringRequest.addressLine1
  // comment) — a candidate tutor's invitation-list query projects only the
  // limited "dispatch location" (city/province/postal prefix) by joining
  // through tutoringRequestId, never selecting the full address columns.
  rankScore          Float
  rankBreakdown      Json
  rankingVersion     String
  createdAt          DateTime              @default(now())
  expiresAt          DateTime
  respondedAt        DateTime?
  declineReason      String?
  bookingId          String?               @unique

  tutoringRequest  TutoringRequest   @relation(fields: [tutoringRequestId], references: [id])
  tutorProfile     TutorProfile      @relation(fields: [tutorProfileId], references: [id])
  tutorPayoutQuote TutorPayoutQuote? @relation(fields: [tutorPayoutQuoteId], references: [id])
  booking          Booking?          @relation(fields: [bookingId], references: [id])

  @@unique([tutoringRequestId, tutorProfileId, dispatchRound])
  @@index([tutoringRequestId, status])
  @@index([tutorProfileId, status])
  @@index([expiresAt])
}

// Single-row (singleton) typed settings for the dispatch loop and ranking
// formula, mirroring MarketplacePricingSettings' exact pattern — a handful
// of scalar tuning knobs, admin-editable without a migration.
model TutorRankingSettings {
  id String @id @default(cuid())

  // Dispatch (see quickMatchDispatch.ts) — sequentialInvitationCount +
  // parallelBatchSize must be <= maxDispatchAttempts (checked at read time,
  // not just at seed time, so the two can never silently drift apart).
  responseWindowMinutes     Int @default(10)
  sequentialInvitationCount Int @default(2)
  parallelBatchSize         Int @default(3)
  maxDispatchAttempts       Int @default(5)

  // Ranking formula weights (see tutorRanking.ts) — must sum to 1.0.
  tutorScoreWeight                 Float @default(0.50)
  bookingReliabilityWeight         Float @default(0.25)
  invitationResponsivenessWeight   Float @default(0.15)
  tutorTierWeight                  Float @default(0.10)
  minInvitationsForReliabilityData Int   @default(5)

  rankingVersion  String   @default("QUICK_MATCH_RANKING_V1")
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
}

// ---------------------------------------------------------------------------
// Payments, Stripe Connect & marketplace financial lifecycle (Phase G).
//
// One principle governs every external Stripe call anywhere in this domain:
// create a durable local row *before* calling Stripe (Step A, pure DB
// write), call Stripe outside any transaction using an idempotency key
// derived from that row's own id (Step B), then converge local state to
// Stripe's authoritative result via an idempotent function safe to call
// from the synchronous caller, the matching webhook, or the reconciliation
// sweep, in any order, any number of times (Step C). See
// src/services/payments.ts, src/services/tutorTransfers.ts.
//
// Ids for rows created in Step A are generated in application code
// (crypto.randomUUID()) rather than left to Prisma's DB-side @default —
// the id must exist before the Stripe call it anchors. @default(cuid())
// stays as a fallback for callers that don't need to pre-know the id.
//
// A Payment is one logical payment obligation for one CustomerPriceQuote,
// normally backed by one Stripe PaymentIntent for its entire lifecycle
// (Stripe supports multiple confirmation attempts against the same PI).
// PaymentAttempt records each confirmation try; in the rare case a PI
// becomes unusable and must be replaced, Payment.stripePaymentIntentId is
// updated to the new one while each PaymentAttempt.stripePaymentIntentId
// preserves which PI it was actually made against — every PI that has ever
// represented a Payment stays traceable via
// resolvePaymentFromStripePaymentIntent (src/services/payments.ts), never
// via a direct Payment.stripePaymentIntentId query alone.
//
// TutorEarning ("FutureTutor owes this tutor $X for this booking") is
// deliberately independent of Stripe Connect readiness — eligibility
// (PENDING_ELIGIBLE -> ELIGIBLE) depends only on eligibleAt and the booking
// not having been voided. TutorTransfer ("FutureTutor moved that $X from
// the platform's Stripe balance to the tutor's connected account balance")
// is a separate, later step that additionally requires payout readiness.
// TutorTransfer never represents Stripe's own subsequent payout from the
// connected account to the tutor's bank — that stays entirely on Stripe's
// side (Connect Express Dashboard), out of scope.
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING // PaymentIntent creation started (Step A committed), not yet confirmed
  REQUIRES_ACTION // 3DS or similar customer action needed
  AUTHORIZED // manual-capture PI confirmed, funds held, not yet captured
  CAPTURED // funds captured — the only status that may cause a Booking to exist
  CAPTURE_FAILED
  // (Phase G.1 correction) A single declined/failed confirmation ATTEMPT
  // does not put the whole payment obligation here — Stripe supports
  // multiple attempts against the same PI (see the domain comment above),
  // so an ordinary decline keeps Payment at PENDING/REQUIRES_ACTION and is
  // recorded instead as a PaymentAttempt row. No current code path writes
  // this value; kept for pre-existing historical rows and reserved for a
  // future genuinely-terminal authorization-phase failure, if one is ever
  // identified — see CAPTURE_FAILED/CANCELLED for the terminal failures
  // that already exist.
  FAILED
  CANCELLED // PI cancelled before capture (e.g. matching produced no tutor)
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentDisputeStatus {
  OPEN
  WON
  LOST
}

model Payment {
  id                         String                @id @default(cuid())
  // The one anchor that exists in both direct booking and Quick Match at
  // authorization time — a quote is consumed exactly once, so this is
  // naturally the right uniqueness key for "one payment obligation."
  customerPriceQuoteId       String                @unique
  // Null until Step A of the booking flow (reserveBookingPendingPayment)
  // creates the PENDING_PAYMENT Booking and links this Payment to it.
  bookingId                  String?               @unique
  // The authenticated actor who paid — distinct from the beneficiary
  // student, mirroring CustomerPriceQuote.createdByUserId's reasoning.
  payerUserId                String
  amountCents                Int
  currency                   String                @default("CAD")
  status                     PaymentStatus         @default(PENDING)
  stripePaymentIntentId      String?               @unique
  // Populated once available (from the succeeded PI's charge) — used for
  // source_transaction on tutor transfers, Stripe fee reconciliation, and
  // refund/dispute traceability. Historical provider identifiers, never
  // derived from current configuration.
  stripeChargeId             String?
  stripeBalanceTransactionId String?
  stripeCustomerId           String?
  // Never fabricated from a hard-coded percentage — populated only once
  // Stripe's own Balance Transaction data is available.
  stripeFeeCents             Int?
  disputeStatus              PaymentDisputeStatus?
  authorizedAt               DateTime?
  capturedAt                 DateTime?
  failedAt                   DateTime?
  cancelledAt                DateTime?
  refundedAmountCents        Int                   @default(0)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  customerPriceQuote CustomerPriceQuote @relation(fields: [customerPriceQuoteId], references: [id])
  booking            Booking?           @relation(fields: [bookingId], references: [id])
  payerUser          User               @relation(fields: [payerUserId], references: [id])
  attempts           PaymentAttempt[]
  refunds            Refund[]

  @@index([status])
}

// Append-only, mirrors TutorExamAttempt's exact established pattern
// (Phase D) — one row per confirmation try against a Payment's PaymentIntent.
// (Phase G.1) Two recording paths write here, both via the shared
// recordPaymentAttempt() helper in src/services/payments.ts:
//  - success: verifyAndAuthorizePaymentIntent(), a synchronous, non-webhook
//    call — sourceStripeEventId stays null; idempotency comes from only
//    calling it when Payment's guarded PENDING/REQUIRES_ACTION -> AUTHORIZED
//    updateMany actually flips a row (count === 1), not on every call.
//  - failure: the payment_intent.payment_failed webhook — sourceStripeEventId
//    is always set to that event's id, which is what makes a Stripe webhook
//    replay of the exact same failed attempt a safe no-op (see the unique
//    constraint below), while a genuinely new decline produces a genuinely
//    new Stripe event id and therefore a new row.
model PaymentAttempt {
  id                    String   @id @default(cuid())
  paymentId             String
  attemptNumber         Int
  // The PI this specific attempt was actually made against — normally
  // identical to Payment.stripePaymentIntentId; differs only in the rare
  // PI-replacement case (see the domain comment above).
  stripePaymentIntentId String
  status                String
  failureCode           String?
  failureMessage        String?
  // Null for the success path (not webhook-sourced). Set to the Stripe
  // event id for the failure path — the idempotency anchor that makes a
  // redelivered payment_intent.payment_failed event a safe no-op rather
  // than a duplicate row, while still letting a genuinely distinct decline
  // (its own distinct Stripe event id) produce its own distinct attempt.
  sourceStripeEventId   String?  @unique
  createdAt             DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, attemptNumber])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id             String       @id @default(cuid())
  paymentId      String
  bookingId      String
  amountCents    Int
  currency       String       @default("CAD")
  reason         String?
  status         RefundStatus @default(PENDING)
  stripeRefundId String?      @unique
  actorUserId    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id])
}

enum TutorEarningStatus {
  PENDING_ELIGIBLE
  ELIGIBLE
  TRANSFERRED
  CANCELLED
  // Phase 5A (Financial Schema Foundation): distinct from CANCELLED, which
  // remains EXCLUSIVELY the H.8 booking-cancellation outcome (written only
  // by cancellationPolicy.ts). HELD means the TutorEarning exists but
  // automatic eligibility/transfer is blocked pending a future authorized
  // operational/financial resolution — intended (not yet implemented as of
  // Phase 5A; see Phase 5B) for TUTOR_NO_SHOW, NO_SHOW_UNRESOLVED, and
  // INTERRUPTED Session outcomes. No writer sets this value in Phase 5A.
  HELD
}

model TutorEarning {
  id             String             @id @default(cuid())
  bookingId      String             @unique
  tutorProfileId String
  amountCents    Int
  currency       String             @default("CAD")
  status         TutorEarningStatus @default(PENDING_ELIGIBLE)
  // [YOUR IDEA — RECOMMENDED PAYOUT TIMING] booking.endAt + 24h — a
  // temporary rule pending the future Session Completion phase. Never
  // gated on Stripe Connect readiness (see the domain comment above).
  //
  // Phase 5A (Financial Schema Foundation): made NULLABLE as a forward-
  // compatible schema evolution only — the correct post-Phase-5 semantic is
  // "the authoritative earliest time this earning may become eligible,"
  // which for an earning whose Session outcome is not yet resolved should
  // be null rather than a fabricated Booking.endAt-derived date. The
  // WRITER above (src/services/payments.ts, TutorEarning creation inside
  // convergeToCaptured) is UNCHANGED in Phase 5A and still always writes
  // booking.endAt + 24h at creation — so this column is never actually null
  // yet at runtime. Phase 5B is expected to change the writer so that
  // creation leaves this null and the authoritative Session outcome sets it
  // later (COMPLETED -> completedAt + 24h; STUDENT_NO_SHOW ->
  // noShowConvergedAt + 24h; TUTOR_NO_SHOW / NO_SHOW_UNRESOLVED /
  // INTERRUPTED -> status = HELD, eligibleAt stays null). Readers MUST fail
  // closed on null (never treat null as "already eligible") — the existing
  // markEligibleEarnings() `eligibleAt: { lte: now }` filter already does
  // this correctly by construction (SQL NULL never satisfies `<=`), so no
  // reader code changed in Phase 5A.
  eligibleAt     DateTime?
  transferredAt  DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())

  booking      Booking        @relation(fields: [bookingId], references: [id])
  tutorProfile TutorProfile   @relation(fields: [tutorProfileId], references: [id])
  transfer     TutorTransfer?

  @@index([tutorProfileId, status])
  @@index([status, eligibleAt])
}

enum TutorTransferStatus {
  PENDING
  COMPLETED
  FAILED
}

model TutorTransfer {
  id                  String              @id @default(cuid())
  tutorEarningId      String              @unique
  tutorProfileId      String
  amountCents         Int
  currency            String              @default("CAD")
  status              TutorTransferStatus @default(PENDING)
  // A COMPLETED transfer that is later reversed stays COMPLETED — reversal
  // is tracked via reversedAmountCents + TutorTransferReversal, never by
  // overloading status: FAILED (that means the transfer attempt itself
  // never succeeded, a categorically different fact).
  reversedAmountCents Int                 @default(0)
  stripeTransferId    String?             @unique
  initiatedAt         DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  failureReason       String?
  createdAt           DateTime            @default(now())

  tutorEarning TutorEarning            @relation(fields: [tutorEarningId], references: [id])
  tutorProfile TutorProfile            @relation(fields: [tutorProfileId], references: [id])
  reversals    TutorTransferReversal[]

  @@index([tutorProfileId, status])
}

// Full or partial, single or repeated reversal of a completed transfer.
// Building this model does not imply FutureTutor automatically reverses
// anything — see the Phase G plan's still-open product decision on when a
// reversal is triggered. This only ensures the schema can represent one.
model TutorTransferReversal {
  id               String   @id @default(cuid())
  tutorTransferId  String
  amountCents      Int
  stripeReversalId String?  @unique
  reason           String?
  createdAt        DateTime @default(now())

  tutorTransfer TutorTransfer @relation(fields: [tutorTransferId], references: [id])
}

enum StripeWebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

// Explicit atomic processing claim (RECEIVED/FAILED -> PROCESSING via a
// guarded updateMany), not just downstream-row guards — protects
// secondary effects (notifications, audit rows) that aren't covered by any
// unique constraint on the target row. See src/app/api/webhooks/stripe.
model StripeWebhookEvent {
  id               String                        @id @default(cuid())
  stripeEventId    String                        @unique
  type             String
  processingStatus StripeWebhookProcessingStatus @default(RECEIVED)
  attemptCount     Int                           @default(0)
  lastAttemptAt    DateTime?
  processedAt      DateTime?
  error            String?
  createdAt        DateTime                      @default(now())
}

model StripeCustomer {
  id               String   @id @default(cuid())
  userId           String   @unique
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Messaging (future phase, not yet built)
// ---------------------------------------------------------------------------

enum MessageType {
  TEXT
  SYSTEM
}

model Conversation {
  id        String   @id @default(cuid())
  bookingId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking      Booking?                  @relation(fields: [bookingId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  content        String      @db.Text
  type           MessageType @default(TEXT)
  sentAt         DateTime    @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Reviews (future phase, not yet built)
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

model Review {
  id               String       @id @default(cuid())
  bookingId        String       @unique
  studentProfileId String
  tutorProfileId   String
  rating           Int
  comment          String?      @db.Text
  status           ReviewStatus @default(PUBLISHED)
  createdAt        DateTime     @default(now())

  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  tutorProfile   TutorProfile   @relation(fields: [tutorProfileId], references: [id])

  @@index([tutorProfileId])
}

// ---------------------------------------------------------------------------
// Notifications (future phase, not yet built)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model NotificationPreference {
  id           String  @id @default(cuid())
  userId       String  @unique
  emailEnabled Boolean @default(true)
  inAppEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// PROD-BOOKING-NOTIFICATIONS1 — durable outbox for the booking-confirmation
// email flow. Deliberately separate from Notification (IN_APP only, no
// dedup/status) rather than overloading it: this needs a real delivery
// state machine (PENDING -> SENT | FAILED, retriable) and a hard
// uniqueness guarantee per (booking, recipient role) so a webhook replay,
// a Server Action retry, or a Railway restart can never produce a second
// email. Rows are created exactly once, inside the same Serializable
// transaction that confirms the Booking (convergeToCaptured), guarded by
// the same "!existingEarning" one-time check already protecting the
// existing in-app Notification writes there — this table adds no new
// business-logic guard of its own, it reuses that one. Actual delivery
// (the Resend network call) happens afterward, outside that transaction —
// see dispatchBookingConfirmationEmails in src/services/bookingNotifications.ts.
enum BookingEmailRecipientRole {
  TUTOR
  PAYER
}

enum BookingEmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model BookingEmailNotification {
  id              String                     @id @default(cuid())
  bookingId       String
  recipientRole   BookingEmailRecipientRole
  // Resolved and stamped at row-creation time from the authoritative
  // source (TutorProfile.userId / Payment.payerUserId) — the dispatcher
  // re-resolves the actual email address fresh from User at send time
  // rather than trusting anything cached here, but the recipient's
  // identity itself (who this row is for) is fixed at creation.
  recipientUserId String
  status          BookingEmailDeliveryStatus @default(PENDING)
  attemptCount    Int                        @default(0)
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  // Sanitized failure reason only (provider error name/message) — never a
  // raw exception, stack trace, or PII. Mirrors resendSendPasswordResetEmail's
  // own "never logs the email body/token" discipline.
  error           String?
  createdAt       DateTime                   @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // The hard idempotency guarantee: at most one row per (booking, role),
  // ever — conceptually the same identity as
  // "booking_confirmed:<role>:<bookingId>".
  @@unique([bookingId, recipientRole])
  @@index([status])
}

// PROD-TUTOR-APPLICATION-NOTIFICATIONS1 — durable outbox for tutor
// application-lifecycle emails, mirroring BookingEmailNotification's exact
// design (PENDING -> SENT | FAILED, retriable, created inside the same
// transaction that commits the workflow transition in
// tutorApplicationWorkflow.ts, dispatched afterward outside it). The
// in-app Notification row for the same business event is written in that
// same transaction via notifyUser — one trigger, two channels, never two
// independent decisions that could disagree.
//
// Idempotency is content-based, not merely transaction-based:
// `dedupeKey` is a deterministic string derived from the specific
// underlying record the event concerns (e.g. `document:<id>:APPROVED`,
// `interview:<id>:scheduled:<epochMs>`, `tutorProfile:<id>:APPROVED`) so a
// repeated Admin click, browser retry, or Railway restart can never
// produce a second row for the same real occurrence, while a genuinely
// new occurrence (a different document, a real reschedule to a new time,
// a second suspend/reactivate cycle) always gets a fresh key. See
// src/services/tutorApplicationNotifications.ts for the exact key
// construction per event.
enum TutorApplicationNotificationEvent {
  APPLICATION_SUBMITTED
  APPLICATION_UNDER_REVIEW
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  ADDITIONAL_INFORMATION_REQUIRED
  INTERVIEW_SCHEDULED
  INTERVIEW_RESCHEDULED
  INTERVIEW_COMPLETED
  TRAINING_UNLOCKED
  TRAINING_COMPLETED
  EXAM_UNLOCKED
  EXAM_PASSED
  EXAM_FAILED
  FINAL_REVIEW_STARTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  APPLICATION_SUSPENDED
  APPLICATION_REACTIVATED
}

enum TutorApplicationNotificationStatus {
  PENDING
  SENT
  FAILED
}

model TutorApplicationNotification {
  id                String                             @id @default(cuid())
  tutorProfileId    String
  event             TutorApplicationNotificationEvent
  // Deterministic, content-derived idempotency key — see the module doc
  // comment above and src/services/tutorApplicationNotifications.ts.
  dedupeKey         String
  // Resolved and stamped at row-creation time from TutorProfile.userId —
  // the dispatcher re-resolves the actual email address fresh from User
  // at send time rather than trusting anything cached here, same
  // discipline as BookingEmailNotification.recipientUserId.
  recipientUserId   String
  status            TutorApplicationNotificationStatus @default(PENDING)
  attemptCount      Int                                @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  // Sanitized failure reason only — never a raw exception/stack trace.
  error             String?
  // Safe Resend-returned message id, for delivery tracing/support only —
  // never a provider secret. May be null even on a SENT row if the
  // adapter could not safely obtain one.
  providerMessageId String?
  // Frozen, event-specific display data resolved once at trigger time
  // (e.g. { documentType, reason } or { scheduledAtIso }) — the dispatcher
  // renders from this snapshot, never by re-querying possibly-since-
  // changed live records, so the email always matches the event that was
  // actually recorded.
  contextSnapshot   Json
  createdAt         DateTime                           @default(now())

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  // The hard idempotency guarantee: at most one row per dedupeKey, ever.
  @@unique([dedupeKey])
  @@index([status])
  @@index([tutorProfileId, createdAt])
}

// ---------------------------------------------------------------------------
// Admin (Phase A: table exists and is written to for role-sensitive auth
// events; real moderation actions start writing to it in Phase G).
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Operational security (BETA-OPS1). Postgres-backed fixed-window rate
// limiting — deliberately not Redis/an external vendor: the existing
// Supabase/Postgres infrastructure already supports an atomic upsert+
// increment cleanly, and this is the only rate-limiting mechanism in the
// app, so a new piece of infrastructure isn't justified. `key` encodes
// scope+identifier+action (e.g. "login:email:foo@example.com" or
// "login:ip:1.2.3.4"), `windowStart` is the current fixed window's start
// instant. One row per (key, windowStart) accumulates a count via an
// atomic `INSERT ... ON CONFLICT DO UPDATE SET count = count + 1`
// (raw SQL, since Prisma's upsert isn't atomic under concurrent writers).
// This design is correct under horizontal scaling (Postgres is the single
// source of truth, not per-instance memory) — see the BETA-OPS1 report for
// the fuller rationale.
// ---------------------------------------------------------------------------

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([key, windowStart])
  @@index([windowStart])
}
