// FutureTutor marketplace schema.
// Grouped by domain; see /prisma/README.md is skipped in favor of inline
// comments — each model notes the phase that actually uses it so an empty
// table isn't mistaken for a bug.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Phase A). Standard Account/Session/VerificationToken shape matches
// what @auth/prisma-adapter expects, so adding Google/Apple OAuth later is
// additive, not a rework — even though Phase A's Credentials-only auth uses
// JWT sessions and doesn't touch these adapter tables yet.
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  PARENT
  TUTOR
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deactivatedAt DateTime?

  accounts                Account[]
  sessions                Session[]
  studentProfile          StudentProfile?
  parentProfile           ParentProfile?
  tutorProfile            TutorProfile?
  sentMessages            Message[]                 @relation("MessageSender")
  conversations           ConversationParticipant[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  auditLogs               AuditLog[]                @relation("AuditActor")
  bookingStatusChanges    BookingStatusHistory[]    @relation("BookingStatusChangedBy")
  createdPriceQuotes      CustomerPriceQuote[]
  createdTutoringRequests TutoringRequest[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Student / Parent (Phase A creates the tables + registration rows;
// StudentProfile fields and LearningGoal get filled in via onboarding UI
// in Phase B).
// ---------------------------------------------------------------------------

enum TutoringMode {
  ONLINE
  IN_PERSON
  BOTH
}

model StudentProfile {
  id                String       @id @default(cuid())
  userId            String       @unique
  firstName         String
  lastName          String
  preferredLanguage String       @default("en")
  province          String?
  city              String?
  academicLevelId   String?
  tutoringMode      TutoringMode @default(BOTH)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicLevel       AcademicLevel?              @relation(fields: [academicLevelId], references: [id])
  parentRelationships ParentStudentRelationship[]
  learningGoals       LearningGoal[]
  favorites           TutorFavorite[]
  bookings            Booking[]
  reviews             Review[]
  priceQuotes         CustomerPriceQuote[]
  tutoringRequests    TutoringRequest[]
}

model ParentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  firstName         String
  lastName          String
  preferredLanguage String   @default("en")
  province          String?
  city              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentRelationships ParentStudentRelationship[]
}

model ParentStudentRelationship {
  id               String   @id @default(cuid())
  parentProfileId  String
  studentProfileId String
  relationshipType String   @default("PARENT")
  createdAt        DateTime @default(now())

  parentProfile  ParentProfile  @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([parentProfileId, studentProfileId])
}

model LearningGoal {
  id               String   @id @default(cuid())
  studentProfileId String
  subjectId        String?
  description      String
  createdAt        DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject        Subject?       @relation(fields: [subjectId], references: [id])
}

// ---------------------------------------------------------------------------
// Tutor (Phase A creates the table + registration row; everything else
// filled in during Phase B onboarding).
// ---------------------------------------------------------------------------

enum TutorApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_REQUIRED
  INTERVIEW_COMPLETED
  TRAINING_REQUIRED
  TRAINING_COMPLETED
  EXAM_REQUIRED
  EXAM_COMPLETED
  FINAL_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum StripeConnectStatus {
  NOT_STARTED
  PENDING
  RESTRICTED
  ACTIVE
  DISABLED
}

// Placeholder tier names (Phase E) — never shown publicly. A simple, explicit,
// admin-set field, not derived from TutorScore/session history/public rating —
// there isn't enough marketplace history yet to justify an automated tier.
enum TutorTier {
  NEW
  VERIFIED
  SENIOR
  ELITE
}

model TutorProfile {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  slug                   String                 @unique
  headline               String?
  bio                    String?                @db.Text
  yearsExperience        Int?
  /// @deprecated Kept only for Phase C booking-flow compatibility. FutureTutor's
  /// business model does not let tutors set the customer price — a dedicated
  /// Customer Price Engine / Tutor Payout Engine replaces this field in the
  /// phase immediately after Tutor Validation Depth. Do not build new features
  /// that treat this as a quality/tier signal or a permanent tutor capability.
  hourlyRateCents        Int?
  currency               String                 @default("CAD")
  applicationStatus      TutorApplicationStatus @default(DRAFT)
  /// null = not yet approved under either process; 1 = approved under the old
  /// simplified process (historical, not retroactively changed); 2 = approved
  /// under the full Tutor Validation Depth pipeline.
  validationVersion      Int?
  // Phase E — simple explicit payout tier, see TutorTier enum comment.
  payoutTier             TutorTier              @default(NEW)
  learningMode           TutoringMode?
  city                   String?
  province               String?
  travelRadiusKm         Int?
  latitude               Float?
  longitude              Float?
  ratingAverage          Float                  @default(0)
  reviewCount            Int                    @default(0)
  stripeConnectAccountId String?
  stripeConnectStatus    StripeConnectStatus    @default(NOT_STARTED)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects               TutorSubject[]
  levels                 TutorLevel[]
  languages              TutorLanguage[]
  education              TutorEducation[]
  certifications         TutorCertification[]
  availability           TutorAvailability[]
  availabilityExceptions TutorAvailabilityException[]
  verifications          TutorVerification[]
  media                  TutorMedia[]
  documents              TutorDocument[]
  interviews             TutorInterview[]
  trainingProgress       TutorTrainingProgress[]
  examAttempts           TutorExamAttempt[]
  scores                 TutorScore[]
  scoreSnapshots         TutorScoreSnapshot[]
  bookings               Booking[]
  favoritedBy            TutorFavorite[]
  reviews                Review[]
  payouts                TutorPayout[]
  payoutQuotes           TutorPayoutQuote[]
  invitations            TutorInvitation[]

  @@index([applicationStatus])
  @@index([city, province])
}

model TutorSubject {
  id             String @id @default(cuid())
  tutorProfileId String
  subjectId      String

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, subjectId])
  @@index([subjectId])
}

model TutorLevel {
  id              String @id @default(cuid())
  tutorProfileId  String
  academicLevelId String

  tutorProfile  TutorProfile  @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  academicLevel AcademicLevel @relation(fields: [academicLevelId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, academicLevelId])
}

model TutorLanguage {
  id             String @id @default(cuid())
  tutorProfileId String
  language       String // ISO code: "en" | "fr" | ...

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, language])
}

enum QualificationVerificationStatus {
  UNVERIFIED
  VERIFIED
}

model TutorEducation {
  id                   String                          @id @default(cuid())
  tutorProfileId       String
  institution          String
  degree               String?
  fieldOfStudy         String?
  startYear            Int?
  endYear              Int?
  verificationStatus   QualificationVerificationStatus @default(UNVERIFIED)
  verifiedByDocumentId String?
  // Admin judgment made on the qualification record itself (at verification
  // time, against a supporting document) — not derived from document count
  // or any automated field-of-study text matching. See TutorScoring service.
  isRelevantToSubjects Boolean?

  tutorProfile      TutorProfile   @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  verifyingDocument TutorDocument? @relation(fields: [verifiedByDocumentId], references: [id])
}

model TutorCertification {
  id                   String                          @id @default(cuid())
  tutorProfileId       String
  name                 String
  issuer               String?
  issueYear            Int?
  credentialUrl        String?
  verificationStatus   QualificationVerificationStatus @default(UNVERIFIED)
  verifiedByDocumentId String?
  isRelevantToSubjects Boolean?

  tutorProfile      TutorProfile   @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  verifyingDocument TutorDocument? @relation(fields: [verifiedByDocumentId], references: [id])
}

model TutorAvailability {
  id             String       @id @default(cuid())
  tutorProfileId String
  dayOfWeek      Int // 0 = Sunday .. 6 = Saturday
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"
  timezone       String // IANA, e.g. "America/Toronto"
  mode           TutoringMode @default(BOTH)

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId, dayOfWeek])
}

model TutorAvailabilityException {
  id             String   @id @default(cuid())
  tutorProfileId String
  date           DateTime
  isAvailable    Boolean
  startTime      String?
  endTime        String?
  reason         String?

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId, date])
}

enum VerificationType {
  IDENTITY
  EDUCATION
  CERTIFICATION
  BACKGROUND_CHECK
  MANUAL_ADMIN_REVIEW
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model TutorVerification {
  id             String             @id @default(cuid())
  tutorProfileId String
  type           VerificationType
  status         VerificationStatus @default(PENDING)
  provider       String?
  reference      String?
  submittedAt    DateTime?
  verifiedAt     DateTime?
  expiresAt      DateTime?
  notes          String?

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
}

model TutorMedia {
  id             String   @id @default(cuid())
  tutorProfileId String
  type           String // "PHOTO" | "DOCUMENT"
  url            String
  createdAt      DateTime @default(now())

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Tutor Validation Depth (Phase D). TutorDocument is private evidence that
// *verifies* a TutorEducation/TutorCertification row — the scoring service
// reads verified qualification records, never document counts. All status
// transitions on TutorProfile.applicationStatus flow exclusively through
// src/services/tutorApplicationWorkflow.ts.
// ---------------------------------------------------------------------------

enum TutorDocumentType {
  TRANSCRIPT
  DIPLOMA
  DEGREE
  CERTIFICATE
  ENROLLMENT_PROOF
  OTHER
}

enum TutorDocumentStatus {
  UPLOADED
  PENDING_REVIEW
  APPROVED
  REJECTED
  REPLACEMENT_REQUIRED
}

model TutorDocument {
  id               String              @id @default(cuid())
  tutorProfileId   String
  type             TutorDocumentType
  // Server-generated (crypto.randomUUID()) — never derived from user input,
  // which eliminates path-traversal by construction.
  storageKey       String              @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  status           TutorDocumentStatus @default(UPLOADED)
  uploadedAt       DateTime            @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  rejectionReason  String?
  adminNotes       String?

  tutorProfile           TutorProfile         @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  verifiedEducations     TutorEducation[]
  verifiedCertifications TutorCertification[]

  @@index([tutorProfileId, status])
}

enum TutorInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model TutorInterview {
  id                String               @id @default(cuid())
  tutorProfileId    String
  scheduledAt       DateTime?
  completedAt       DateTime?
  interviewerUserId String?
  status            TutorInterviewStatus @default(SCHEDULED)
  overallNotes      String?              @db.Text

  tutorProfile TutorProfile               @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  evaluations  TutorInterviewEvaluation[]

  @@index([tutorProfileId, status])
}

enum TutorInterviewCriterion {
  COMMUNICATION
  PEDAGOGY
  PROFESSIONALISM
  SUBJECT_CONFIDENCE
  STUDENT_INTERACTION
  MOTIVATION_ALIGNMENT
}

model TutorInterviewEvaluation {
  id               String                  @id @default(cuid())
  tutorInterviewId String
  criterion        TutorInterviewCriterion
  score            Int // 1-5
  notes            String?

  tutorInterview TutorInterview @relation(fields: [tutorInterviewId], references: [id], onDelete: Cascade)

  @@unique([tutorInterviewId, criterion])
}

model TrainingModule {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String   @db.Text
  // Video-ready even though this phase's completion mechanic is a simple
  // acknowledgment — no player is built this phase.
  videoUrl        String?
  videoAssetKey   String?
  durationMinutes Int?
  sortOrder       Int      @default(0)
  isRequired      Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  progress TutorTrainingProgress[]
}

model TutorTrainingProgress {
  id               String    @id @default(cuid())
  tutorProfileId   String
  trainingModuleId String
  startedAt        DateTime?
  completedAt      DateTime?
  progressPercent  Int       @default(0)

  tutorProfile   TutorProfile   @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  trainingModule TrainingModule @relation(fields: [trainingModuleId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, trainingModuleId])
}

enum TutorExamType {
  PLATFORM
  SUBJECT
}

model TutorExam {
  id           String        @id @default(cuid())
  type         TutorExamType
  subjectId    String?
  title        String
  passingScore Int // 0-100

  subject  Subject?           @relation(fields: [subjectId], references: [id])
  attempts TutorExamAttempt[]
}

model TutorExamAttempt {
  id             String    @id @default(cuid())
  tutorProfileId String
  tutorExamId    String
  attemptNumber  Int
  score          Int // 0-100
  passed         Boolean
  startedAt      DateTime
  submittedAt    DateTime?

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  tutorExam    TutorExam    @relation(fields: [tutorExamId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, tutorExamId, attemptNumber])
}

enum TutorScoreConfidence {
  LOW
  MEDIUM
  HIGH
}

model TutorScore {
  id             String               @id @default(cuid())
  tutorProfileId String
  // Non-null, normalized — never relies on Postgres's NULL-is-distinct
  // unique semantics. Only "OVERALL"/"OVERALL" is written this phase; the
  // shape supports e.g. "SUBJECT"/"math" or "SUBJECT_LEVEL"/"math:highSchool"
  // later without a migration.
  scopeType      String               @default("OVERALL")
  scopeKey       String               @default("OVERALL")
  score          Int // 0-100, private — never shown alongside the public rating
  confidence     TutorScoreConfidence
  scoreVersion   String // e.g. "INITIAL_V1"
  breakdown      Json
  calculatedAt   DateTime             @default(now())

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, scopeType, scopeKey])
}

model TutorScoreSnapshot {
  id             String               @id @default(cuid())
  tutorProfileId String
  scopeType      String               @default("OVERALL")
  scopeKey       String               @default("OVERALL")
  score          Int
  confidence     TutorScoreConfidence
  scoreVersion   String
  breakdown      Json
  calculatedAt   DateTime
  createdAt      DateTime             @default(now())

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId, createdAt])
}

// ---------------------------------------------------------------------------
// Marketplace (Phase A: Subject/AcademicLevel seeded from existing
// content/subjects.ts slugs, replacing the static fixture; TutorFavorite
// starts getting used in Phase B).
// ---------------------------------------------------------------------------

model Subject {
  id        String  @id @default(cuid())
  slug      String  @unique
  category  String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  tutorSubjects    TutorSubject[]
  learningGoals    LearningGoal[]
  bookings         Booking[]
  tutorExams       TutorExam[]
  basePriceRules   CustomerBasePriceRule[]
  basePayoutRules  TutorBasePayoutRule[]
  priceQuotes      CustomerPriceQuote[]
  payoutQuotes     TutorPayoutQuote[]
  tutoringRequests TutoringRequest[]
}

model AcademicLevel {
  id        String @id @default(cuid())
  slug      String @unique
  sortOrder Int    @default(0)

  tutorLevels      TutorLevel[]
  studentProfiles  StudentProfile[]
  bookings         Booking[]
  basePriceRules   CustomerBasePriceRule[]
  basePayoutRules  TutorBasePayoutRule[]
  priceQuotes      CustomerPriceQuote[]
  payoutQuotes     TutorPayoutQuote[]
  tutoringRequests TutoringRequest[]
}

model TutorFavorite {
  id               String   @id @default(cuid())
  studentProfileId String
  tutorProfileId   String
  createdAt        DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  tutorProfile   TutorProfile   @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, tutorProfileId])
}

// ---------------------------------------------------------------------------
// Bookings (Phase C)
// ---------------------------------------------------------------------------

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
  NO_SHOW
  REFUNDED
  RESCHEDULED
}

model Booking {
  id                       String        @id @default(cuid())
  studentProfileId         String
  tutorProfileId           String
  subjectId                String
  academicLevelId          String?
  startAt                  DateTime
  endAt                    DateTime
  timezone                 String
  mode                     TutoringMode
  locationNote             String?
  /// @deprecated Legacy Phase C snapshot of the tutor's own rate. Nullable
  /// since Phase E — existing rows keep their historical value untouched;
  /// new bookings no longer populate it (see customerBasePriceCents etc.
  /// below, sourced from CustomerPriceQuote/TutorPayoutQuote instead).
  hourlyRateCentsSnapshot  Int?
  platformFeeCentsSnapshot Int
  currency                 String        @default("CAD")
  totalCents               Int
  status                   BookingStatus @default(DRAFT)
  notes                    String?
  cancelledByUserId        String?
  cancelledAt              DateTime?
  cancellationReason       String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  // --- Phase E financial snapshot (nullable — legacy Phase C bookings have
  // none of these; every new booking sets them from the consumed quotes) ---
  customerPriceQuoteId       String?
  tutorPayoutQuoteId         String?
  customerBasePriceCents     Int?
  customerAdjustmentCents    Int?
  customerSubtotalCents      Int?
  taxCents                   Int?
  tutorPayoutBaseCents       Int?
  tutorPayoutAdjustmentCents Int?
  tutorPayoutCents           Int?
  grossSpreadCents           Int?
  customerPricingVersion     String?
  tutorPayoutVersion         String?

  // --- Phase F (Quick Match) — nullable, direct/Browse-Tutors bookings
  // (Phase C/E) leave all six of these null; only Quick Match bookings
  // populate them. tutoringRequestId traces a booking back to the request
  // that produced it. The five location fields are an authoritative
  // snapshot, independent of any later change to the source TutoringRequest
  // — the same "snapshot, don't reference-and-hope" principle Phase E
  // already used for pricing. locationNote (above) stays a separate,
  // free-text supplementary field (e.g. "buzz #402"), not the authoritative
  // address.
  tutoringRequestId   String?
  bookingAddressLine1 String?
  bookingAddressLine2 String?
  bookingCity         String?
  bookingProvince     String?
  bookingPostalCode   String?

  studentProfile     StudentProfile         @relation(fields: [studentProfileId], references: [id])
  tutorProfile       TutorProfile           @relation(fields: [tutorProfileId], references: [id])
  subject            Subject                @relation(fields: [subjectId], references: [id])
  academicLevel      AcademicLevel?         @relation(fields: [academicLevelId], references: [id])
  customerPriceQuote CustomerPriceQuote?    @relation(fields: [customerPriceQuoteId], references: [id])
  tutorPayoutQuote   TutorPayoutQuote?      @relation(fields: [tutorPayoutQuoteId], references: [id])
  tutoringRequest    TutoringRequest?       @relation(fields: [tutoringRequestId], references: [id])
  winningInvitation  TutorInvitation?
  statusHistory      BookingStatusHistory[]
  session            Session_?
  payment            Payment?
  review             Review?
  conversation       Conversation?

  @@index([studentProfileId])
  @@index([tutorProfileId])
  @@index([startAt])
  @@index([status])
  @@index([tutorProfileId, startAt])
  @@index([tutoringRequestId])
}

model BookingStatusHistory {
  id              String         @id @default(cuid())
  bookingId       String
  fromStatus      BookingStatus?
  toStatus        BookingStatus
  changedByUserId String?
  reason          String?
  createdAt       DateTime       @default(now())

  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedByUser User?   @relation("BookingStatusChangedBy", fields: [changedByUserId], references: [id])
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

// Named Session_ to avoid clashing with NextAuth's own `Session` model above
// — this one is the tutoring event, not an auth session.
model Session_ {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  startedAt         DateTime?
  endedAt           DateTime?
  status            SessionStatus @default(SCHEDULED)
  tutorAttendance   Boolean?
  studentAttendance Boolean?
  onlineMeetingUrl  String?
  notes             String?       @db.Text

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("Session_tutoring")
}

// ---------------------------------------------------------------------------
// Pricing & Payouts (Phase E — Customer Price Engine + Tutor Payout Engine).
// Two independent, versioned, auditable financial engines: one decides what
// the customer pays, one decides what the tutor earns. Never a fixed
// percentage of each other — see src/services/customerPricing.ts and
// src/services/tutorPayout.ts for the calculation order.
// ---------------------------------------------------------------------------

model CustomerBasePriceRule {
  id                  String    @id @default(cuid())
  // null = wildcard, used for rule-priority fallback resolution.
  subjectId           String?
  academicLevelId     String?
  baseDurationMinutes Int
  basePriceCents      Int
  currency            String    @default("CAD")
  effectiveFrom       DateTime  @default(now())
  effectiveUntil      DateTime?
  isActive            Boolean   @default(true)
  pricingVersion      String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  subject       Subject?             @relation(fields: [subjectId], references: [id])
  academicLevel AcademicLevel?       @relation(fields: [academicLevelId], references: [id])
  quotes        CustomerPriceQuote[]

  @@index([subjectId, academicLevelId, isActive])
}

model TutorBasePayoutRule {
  id                  String    @id @default(cuid())
  tutorTier           TutorTier
  subjectId           String?
  academicLevelId     String?
  baseDurationMinutes Int
  payoutCents         Int
  currency            String    @default("CAD")
  isActive            Boolean   @default(true)
  effectiveFrom       DateTime  @default(now())
  effectiveUntil      DateTime?
  payoutVersion       String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  subject       Subject?           @relation(fields: [subjectId], references: [id])
  academicLevel AcademicLevel?     @relation(fields: [academicLevelId], references: [id])
  quotes        TutorPayoutQuote[]

  @@index([tutorTier, subjectId, academicLevelId, isActive])
}

// Single-row (singleton) typed settings — a handful of scalar tuning knobs,
// deliberately not a generic key-value/JSON config table (that pattern is
// reserved for CustomerBasePriceRule/TutorBasePayoutRule's real relational
// rules). Mutated in place; configVersion is what lets a quote record which
// settings state produced it.
model MarketplacePricingSettings {
  id                               String   @id @default(cuid())
  quoteTtlMinutes                  Int      @default(15)
  urgencyShortNoticeThresholdHours Int      @default(48)
  urgencyShortNoticeAmountCents    Int      @default(300)
  urgencyUrgentThresholdHours      Int      @default(24)
  urgencyUrgentAmountCents         Int      @default(600)
  lowSupplyThresholdCount          Int      @default(2)
  lowSupplyAmountCents             Int      @default(400)
  tutorUrgencyBonusCents           Int      @default(400)
  minimumGrossSpreadCents          Int      @default(0)
  configVersion                    String   @default("MARKETPLACE_SETTINGS_V1")
  updatedAt                        DateTime @updatedAt
  updatedByUserId                  String?
}

enum CustomerQuoteStatus {
  ACTIVE
  // Phase F (Quick Match) — the student has confirmed this exact price for a
  // TutoringRequest; it is now immutable and never recalculated. expiresAt is
  // no longer checked once LOCKED — only the parent TutoringRequest's own
  // lifecycle governs whether this quote may still reach CONSUMED. Direct
  // booking (Phase C/E) never passes through this state (ACTIVE -> CONSUMED
  // directly), since it has no confirm-then-match gap for LOCKED to bridge.
  LOCKED
  EXPIRED
  CONSUMED
  CANCELLED
}

model CustomerPriceQuote {
  id                       String              @id @default(cuid())
  // The authenticated actor who requested the quote (may be a parent booking
  // for a child later) — distinct from studentProfileId, the beneficiary.
  createdByUserId          String
  studentProfileId         String
  subjectId                String
  academicLevelId          String?
  tutoringMode             TutoringMode
  durationMinutes          Int
  requestedStartAt         DateTime
  currency                 String              @default("CAD")
  basePriceCents           Int
  basePriceRuleId          String
  basePriceRuleVersion     String
  adjustmentsTotalCents    Int
  subtotalCents            Int
  taxCents                 Int
  taxConfigured            Boolean             @default(false)
  totalCents               Int
  pricingVersion           String
  marketplaceConfigVersion String
  contextHash              String
  breakdown                Json
  contextSnapshot          Json
  status                   CustomerQuoteStatus @default(ACTIVE)
  createdAt                DateTime            @default(now())
  expiresAt                DateTime
  // Phase F — set once, when status moves ACTIVE -> LOCKED (the student
  // confirmed a TutoringRequest). expiresAt is never consulted again after
  // this is set; see the CustomerQuoteStatus.LOCKED comment above.
  lockedAt                 DateTime?
  consumedAt               DateTime?
  cancelledAt              DateTime?

  createdByUser    User                  @relation(fields: [createdByUserId], references: [id])
  studentProfile   StudentProfile        @relation(fields: [studentProfileId], references: [id])
  subject          Subject               @relation(fields: [subjectId], references: [id])
  academicLevel    AcademicLevel?        @relation(fields: [academicLevelId], references: [id])
  basePriceRule    CustomerBasePriceRule @relation(fields: [basePriceRuleId], references: [id])
  payoutQuotes     TutorPayoutQuote[]
  bookings         Booking[]
  tutoringRequests TutoringRequest[]

  @@index([createdByUserId, status])
  @@index([studentProfileId, status])
  @@index([expiresAt])
}

enum TutorPayoutQuoteStatus {
  ACTIVE
  EXPIRED
  ACCEPTED
  CONSUMED
  DECLINED
  SUPERSEDED
  CANCELLED
}

model TutorPayoutQuote {
  id                       String                 @id @default(cuid())
  tutorProfileId           String
  customerPriceQuoteId     String
  subjectId                String
  academicLevelId          String?
  tutoringMode             TutoringMode
  durationMinutes          Int
  requestedStartAt         DateTime
  currency                 String                 @default("CAD")
  basePayoutCents          Int
  basePayoutRuleId         String
  basePayoutRuleVersion    String
  tutorTierAtCalculation   TutorTier
  adjustmentsTotalCents    Int
  totalPayoutCents         Int
  payoutVersion            String
  marketplaceConfigVersion String
  breakdown                Json
  status                   TutorPayoutQuoteStatus @default(ACTIVE)
  createdAt                DateTime               @default(now())
  expiresAt                DateTime
  acceptedAt               DateTime?
  consumedAt               DateTime?
  declinedAt               DateTime?
  cancelledAt              DateTime?

  tutorProfile       TutorProfile        @relation(fields: [tutorProfileId], references: [id])
  customerPriceQuote CustomerPriceQuote  @relation(fields: [customerPriceQuoteId], references: [id])
  subject            Subject             @relation(fields: [subjectId], references: [id])
  academicLevel      AcademicLevel?      @relation(fields: [academicLevelId], references: [id])
  basePayoutRule     TutorBasePayoutRule @relation(fields: [basePayoutRuleId], references: [id])
  bookings           Booking[]
  invitations        TutorInvitation[]

  @@index([tutorProfileId, status])
  @@index([customerPriceQuoteId])
}

// ---------------------------------------------------------------------------
// Quick Match & Tutor Dispatch (Phase F). Orchestration layer on top of the
// Customer Price Engine / Tutor Payout Engine above — a TutoringRequest's
// price is locked (CustomerPriceQuote LOCKED) at confirmation, before
// matching starts, so a multi-round dispatch process can never change what
// the student was told they'd pay. A TutorInvitation is both the per-tutor
// dispatch attempt and its own audit record (rankScore/rankBreakdown) — no
// separate MatchingAttempt/DispatchAttempt table exists. Direct booking
// (Phase C/E, "Browse Tutors") is untouched by any of this; both flows share
// one booking-creation core (see src/services/bookingCreation.ts).
// ---------------------------------------------------------------------------

enum TutoringRequestStatus {
  DRAFT
  PRICED
  CONFIRMED
  MATCHING
  BOOKED
  CANCELLED
  EXPIRED
  NO_TUTOR_FOUND
  FAILED
}

model TutoringRequest {
  id               String       @id @default(cuid())
  createdByUserId  String
  studentProfileId String
  subjectId        String
  academicLevelId  String?
  tutoringMode     TutoringMode
  durationMinutes  Int
  requestedStartAt DateTime
  // Request location (private, full precision) — required by
  // src/schemas/tutoringRequest.ts whenever tutoringMode !== ONLINE;
  // addressLine1/addressLine2/postalCode stay null for ONLINE requests.
  // Never copied onto TutorInvitation — see TutorInvitation's own comment.
  addressLine1     String?
  addressLine2     String?
  city             String?
  province         String?
  postalCode       String?
  notes            String?
  currency         String       @default("CAD")

  // Locked price snapshot — filled in when the linked CustomerPriceQuote
  // moves ACTIVE -> LOCKED (PRICED -> CONFIRMED). Null before then.
  customerPriceQuoteId  String?
  basePriceCents        Int?
  adjustmentsTotalCents Int?
  taxCents              Int?
  totalCents            Int?
  pricingVersion        String?

  status        TutoringRequestStatus @default(DRAFT)
  dispatchRound Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  confirmedAt   DateTime?
  bookedAt      DateTime?
  cancelledAt   DateTime?

  createdByUser      User                @relation(fields: [createdByUserId], references: [id])
  studentProfile     StudentProfile      @relation(fields: [studentProfileId], references: [id])
  subject            Subject             @relation(fields: [subjectId], references: [id])
  academicLevel      AcademicLevel?      @relation(fields: [academicLevelId], references: [id])
  customerPriceQuote CustomerPriceQuote? @relation(fields: [customerPriceQuoteId], references: [id])
  invitations        TutorInvitation[]
  bookings           Booking[]

  @@index([createdByUserId, status])
  @@index([studentProfileId, status])
  @@index([status])
}

enum TutorInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  SUPERSEDED
}

model TutorInvitation {
  id                 String                @id @default(cuid())
  tutoringRequestId  String
  tutorProfileId     String
  tutorPayoutQuoteId String?
  dispatchRound      Int
  isParallelRound    Boolean               @default(false)
  status             TutorInvitationStatus @default(PENDING)
  // Snapshot of the ranking decision that produced this dispatch — every
  // invitation is independently explainable after the fact. Deliberately
  // does NOT carry the request's address (see TutoringRequest.addressLine1
  // comment) — a candidate tutor's invitation-list query projects only the
  // limited "dispatch location" (city/province/postal prefix) by joining
  // through tutoringRequestId, never selecting the full address columns.
  rankScore          Float
  rankBreakdown      Json
  rankingVersion     String
  createdAt          DateTime              @default(now())
  expiresAt          DateTime
  respondedAt        DateTime?
  declineReason      String?
  bookingId          String?               @unique

  tutoringRequest  TutoringRequest   @relation(fields: [tutoringRequestId], references: [id])
  tutorProfile     TutorProfile      @relation(fields: [tutorProfileId], references: [id])
  tutorPayoutQuote TutorPayoutQuote? @relation(fields: [tutorPayoutQuoteId], references: [id])
  booking          Booking?          @relation(fields: [bookingId], references: [id])

  @@unique([tutoringRequestId, tutorProfileId, dispatchRound])
  @@index([tutoringRequestId, status])
  @@index([tutorProfileId, status])
  @@index([expiresAt])
}

// Single-row (singleton) typed settings for the dispatch loop and ranking
// formula, mirroring MarketplacePricingSettings' exact pattern — a handful
// of scalar tuning knobs, admin-editable without a migration.
model TutorRankingSettings {
  id String @id @default(cuid())

  // Dispatch (see quickMatchDispatch.ts) — sequentialInvitationCount +
  // parallelBatchSize must be <= maxDispatchAttempts (checked at read time,
  // not just at seed time, so the two can never silently drift apart).
  responseWindowMinutes     Int @default(10)
  sequentialInvitationCount Int @default(2)
  parallelBatchSize         Int @default(3)
  maxDispatchAttempts       Int @default(5)

  // Ranking formula weights (see tutorRanking.ts) — must sum to 1.0.
  tutorScoreWeight                 Float @default(0.50)
  bookingReliabilityWeight         Float @default(0.25)
  invitationResponsivenessWeight   Float @default(0.15)
  tutorTierWeight                  Float @default(0.10)
  minInvitationsForReliabilityData Int   @default(5)

  rankingVersion  String   @default("QUICK_MATCH_RANKING_V1")
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
}

// ---------------------------------------------------------------------------
// Stripe payment capture & payout transfer (future phase, not yet built —
// this session's real Phase E built the pre-payment pricing/payout *quote*
// engine below; these models are the later money-movement layer that will
// consume CustomerPriceQuote.totalCents / Booking.tutorPayoutCents).
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String        @unique
  stripePaymentIntentId String?       @unique
  amountCents           Int
  platformFeeCents      Int
  tutorPayoutCents      Int
  currency              String        @default("CAD")
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds Refund[]
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
}

model TutorPayout {
  id               String       @id @default(cuid())
  tutorProfileId   String
  amountCents      Int
  currency         String       @default("CAD")
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?
  periodStart      DateTime?
  periodEnd        DateTime?
  paidAt           DateTime?
  createdAt        DateTime     @default(now())

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id])
}

model Refund {
  id             String   @id @default(cuid())
  paymentId      String
  amountCents    Int
  reason         String?
  status         String   @default("PENDING")
  stripeRefundId String?
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model StripeCustomer {
  id               String   @id @default(cuid())
  userId           String   @unique
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Messaging (future phase, not yet built)
// ---------------------------------------------------------------------------

enum MessageType {
  TEXT
  SYSTEM
}

model Conversation {
  id        String   @id @default(cuid())
  bookingId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking      Booking?                  @relation(fields: [bookingId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  content        String      @db.Text
  type           MessageType @default(TEXT)
  sentAt         DateTime    @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Reviews (future phase, not yet built)
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

model Review {
  id               String       @id @default(cuid())
  bookingId        String       @unique
  studentProfileId String
  tutorProfileId   String
  rating           Int
  comment          String?      @db.Text
  status           ReviewStatus @default(PUBLISHED)
  createdAt        DateTime     @default(now())

  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  tutorProfile   TutorProfile   @relation(fields: [tutorProfileId], references: [id])

  @@index([tutorProfileId])
}

// ---------------------------------------------------------------------------
// Notifications (future phase, not yet built)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model NotificationPreference {
  id           String  @id @default(cuid())
  userId       String  @unique
  emailEnabled Boolean @default(true)
  inAppEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Admin (Phase A: table exists and is written to for role-sensitive auth
// events; real moderation actions start writing to it in Phase G).
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}
